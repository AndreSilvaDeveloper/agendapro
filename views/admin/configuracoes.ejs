<%- include('../partials/head', { pageTitle: 'Configuracoes' }) %>
<%- include('../partials/sidebar', { activePage: 'config' }) %>

<div style="max-width: 600px;">
  <h1 class="mb-6">Configuracoes</h1>

  <div class="card">
    <div class="card-body">
      <% var s = (typeof settings !== 'undefined') ? settings : {}; %>
      <form action="/admin/configuracoes" method="POST">
        <div class="form-group">
          <label class="form-label">Tema</label>
          <select name="theme" class="form-control">
            <option value="light" <%= s.theme === 'light' ? 'selected' : '' %>>Claro</option>
            <option value="dark" <%= s.theme === 'dark' ? 'selected' : '' %>>Escuro</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Mensagem WhatsApp (Template)</label>
          <textarea name="whatsappTemplate" rows="4" class="form-control" placeholder="Ola {cliente}, lembramos do seu agendamento..."><%= s.whatsappTemplate || '' %></textarea>
          <div class="text-xs text-secondary mt-2">
            Variaveis: <span class="tag">{cliente}</span> <span class="tag">{empresa}</span> <span class="tag">{data}</span> <span class="tag">{hora}</span> <span class="tag">{servico}</span>
          </div>
        </div>

        <div class="form-group">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="automaticReminders" <%= s.automaticReminders ? 'checked' : '' %>>
            <span>Enviar lembretes automaticos pelo WhatsApp (24h e 3h antes)</span>
          </label>
        </div>

        <div class="divider"></div>
        <h3 class="mb-4">Pagina Publica</h3>

        <div class="form-group">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="showAddress" <%= s.showAddress ? 'checked' : '' %>>
            <span>Mostrar endereco</span>
          </label>
        </div>
        <div class="form-group">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="showOperatingHours" <%= s.showOperatingHours ? 'checked' : '' %>>
            <span>Mostrar horario de funcionamento</span>
          </label>
        </div>
        <div class="form-group">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="showGallery" <%= s.showGallery ? 'checked' : '' %>>
            <span>Mostrar galeria</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg mt-4"><i class="fas fa-save"></i> Salvar Configuracoes</button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
