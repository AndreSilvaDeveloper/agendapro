<%- include('../partials/head', { pageTitle: 'WhatsApp' }) %>
<%- include('../partials/sidebar', { activePage: 'whatsapp' }) %>

<div style="max-width: 700px;">
  <h1 class="mb-6"><i class="fab fa-whatsapp" style="color: #25D366; margin-right: 8px;"></i> WhatsApp</h1>

  <!-- Status da Conexao -->
  <div class="card mb-4">
    <div class="card-header"><h3><i class="fas fa-signal" style="color: var(--primary); margin-right: 8px;"></i> Status da Conexao</h3></div>
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div id="statusIcon" class="stat-icon <%= connectionStatus === 'connected' ? 'green' : 'red' %>">
            <i class="fas <%= connectionStatus === 'connected' ? 'fa-check' : 'fa-times' %>"></i>
          </div>
          <div>
            <div id="statusText" class="font-semibold">
              <% if (connectionStatus === 'connected') { %>
                Conectado
              <% } else if (instanceName) { %>
                Desconectado
              <% } else { %>
                Nao configurado
              <% } %>
            </div>
            <div class="text-xs text-secondary">
              <% if (instanceName) { %>
                Instancia: <strong><%= instanceName %></strong>
              <% } else { %>
                Crie uma instancia para comecar
              <% } %>
            </div>
          </div>
        </div>
        <div class="flex gap-2">
          <% if (!instanceName) { %>
            <button onclick="createInstance()" class="btn btn-primary" id="btnCreate">
              <i class="fas fa-plus"></i> Criar Instancia
            </button>
          <% } else if (connectionStatus !== 'connected') { %>
            <button onclick="showQrCode()" class="btn btn-success" id="btnConnect">
              <i class="fab fa-whatsapp"></i> Conectar
            </button>
          <% } else { %>
            <button onclick="disconnect()" class="btn btn-danger" id="btnDisconnect">
              <i class="fas fa-unlink"></i> Desconectar
            </button>
          <% } %>
        </div>
      </div>

      <!-- QR Code -->
      <div id="qrArea" style="display:none; text-align:center; margin-top: 20px;">
        <p class="mb-3">Escaneie o QR Code com seu WhatsApp:</p>
        <div id="qrLoading"><i class="fas fa-spinner spinner"></i> Gerando QR Code...</div>
        <img id="qrImage" src="" alt="QR Code" style="display:none; max-width: 300px; margin: 0 auto; border-radius: 8px;">
        <p class="text-xs text-secondary mt-2">O QR Code expira em 40 segundos. Clique em "Conectar" para gerar outro.</p>
      </div>
    </div>
  </div>

  <% if (instanceName) { %>
  <!-- Bot WhatsApp -->
  <div class="card mb-4">
    <div class="card-header"><h3><i class="fas fa-robot" style="color: var(--primary); margin-right: 8px;"></i> Bot de Atendimento</h3></div>
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <div class="font-semibold">Atendimento automatico pelo WhatsApp</div>
          <div class="text-xs text-secondary">Clientes podem agendar, consultar e cancelar pelo WhatsApp</div>
        </div>
        <label class="switch">
          <input type="checkbox" id="botToggle" <%= botEnabled ? 'checked' : '' %> onchange="toggleBot()">
          <span class="slider round"></span>
        </label>
      </div>
      <div id="botStatus" class="mt-2 text-xs">
        <% if (botEnabled) { %>
          <span style="color: var(--success);"><i class="fas fa-check-circle"></i> Bot ativo</span>
        <% } else { %>
          <span style="color: var(--text-secondary);"><i class="fas fa-pause-circle"></i> Bot desativado</span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Testar envio -->
  <% if (connectionStatus === 'connected') { %>
  <div class="card mb-4">
    <div class="card-header"><h3><i class="fas fa-paper-plane" style="color: var(--primary); margin-right: 8px;"></i> Testar Envio</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Numero de telefone</label>
        <input type="text" id="testPhone" class="form-control" placeholder="(11) 99999-9999">
      </div>
      <button id="btnTest" onclick="testWhatsApp()" class="btn btn-success">
        <i class="fab fa-whatsapp"></i> Enviar mensagem de teste
      </button>
      <div id="testResult" class="mt-3" style="display:none;"></div>
    </div>
  </div>
  <% } %>
  <% } %>

  <!-- Como funciona -->
  <div class="card">
    <div class="card-header"><h3>Como funciona</h3></div>
    <div class="card-body">
      <ol style="padding-left: 20px; line-height: 2;">
        <li>Clique em <strong>"Criar Instancia"</strong> para gerar sua conexao WhatsApp</li>
        <li>Escaneie o <strong>QR Code</strong> com o WhatsApp do seu salao</li>
        <li>Ative o <strong>Bot</strong> para atendimento automatico</li>
        <li>Seus clientes poderao agendar, consultar e cancelar pelo WhatsApp!</li>
      </ol>
      <div class="alert alert-info mt-4">
        <i class="fas fa-info-circle"></i>
        <span>Lembretes automaticos (24h e 3h antes) funcionam quando ativados em <a href="/admin/configuracoes">Configuracoes</a>.</span>
      </div>
    </div>
  </div>
</div>

<style>
.switch { position: relative; display: inline-block; width: 50px; height: 26px; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .3s; border-radius: 26px; }
.slider:before { position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%; }
input:checked + .slider { background-color: #25D366; }
input:checked + .slider:before { transform: translateX(24px); }
</style>

<script>
  var pollInterval = null;

  async function createInstance() {
    var btn = document.getElementById('btnCreate');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner spinner"></i> Criando...';
    try {
      var res = await fetch('/api/whatsapp/create-instance', { method: 'POST' });
      var data = await res.json();
      if (res.ok) {
        location.reload();
      } else {
        alert(data.error || 'Erro ao criar instancia');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus"></i> Criar Instancia';
      }
    } catch(e) {
      alert('Erro de conexao');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-plus"></i> Criar Instancia';
    }
  }

  async function showQrCode() {
    var qrArea = document.getElementById('qrArea');
    var qrImage = document.getElementById('qrImage');
    var qrLoading = document.getElementById('qrLoading');

    qrArea.style.display = 'block';
    qrImage.style.display = 'none';
    qrLoading.style.display = 'block';

    try {
      var res = await fetch('/api/whatsapp/qrcode');
      var data = await res.json();

      if (data.qrcode) {
        qrImage.src = data.qrcode;
        qrImage.style.display = 'block';
        qrLoading.style.display = 'none';
        startPolling();
      } else {
        qrLoading.innerHTML = '<i class="fas fa-exclamation-circle"></i> Nao foi possivel gerar o QR Code. Tente novamente.';
      }
    } catch(e) {
      qrLoading.innerHTML = '<i class="fas fa-exclamation-circle"></i> Erro de conexao';
    }
  }

  function startPolling() {
    if (pollInterval) clearInterval(pollInterval);
    pollInterval = setInterval(async () => {
      try {
        var res = await fetch('/api/whatsapp/status');
        var data = await res.json();
        if (data.status === 'connected') {
          clearInterval(pollInterval);
          location.reload();
        }
      } catch(e) {}
    }, 3000);
  }

  async function disconnect() {
    if (!confirm('Deseja desconectar o WhatsApp?')) return;
    var btn = document.getElementById('btnDisconnect');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner spinner"></i> Desconectando...';
    try {
      await fetch('/api/whatsapp/disconnect', { method: 'POST' });
      location.reload();
    } catch(e) {
      alert('Erro ao desconectar');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-unlink"></i> Desconectar';
    }
  }

  async function toggleBot() {
    try {
      var res = await fetch('/api/whatsapp/toggle-bot', { method: 'POST' });
      var data = await res.json();
      var statusEl = document.getElementById('botStatus');
      if (data.botEnabled) {
        statusEl.innerHTML = '<span style="color: var(--success);"><i class="fas fa-check-circle"></i> Bot ativo</span>';
      } else {
        statusEl.innerHTML = '<span style="color: var(--text-secondary);"><i class="fas fa-pause-circle"></i> Bot desativado</span>';
      }
    } catch(e) {
      alert('Erro ao alterar bot');
    }
  }

  async function testWhatsApp() {
    var phone = document.getElementById('testPhone').value.trim();
    if (!phone) { alert('Digite um numero'); return; }
    var btn = document.getElementById('btnTest');
    var result = document.getElementById('testResult');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner spinner"></i> Enviando...';
    result.style.display = 'none';
    try {
      var res = await fetch('/api/whatsapp/test', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ phone: phone })
      });
      var data = await res.json();
      if (res.ok) {
        result.className = 'alert alert-success mt-3';
        result.innerHTML = '<i class="fas fa-check-circle"></i> ' + (data.message || 'Enviado!');
      } else {
        result.className = 'alert alert-danger mt-3';
        result.innerHTML = '<i class="fas fa-exclamation-circle"></i> ' + (data.error || 'Erro');
      }
      result.style.display = 'block';
    } catch(e) {
      result.className = 'alert alert-danger mt-3';
      result.innerHTML = '<i class="fas fa-exclamation-circle"></i> Erro de conexao';
      result.style.display = 'block';
    }
    btn.disabled = false;
    btn.innerHTML = '<i class="fab fa-whatsapp"></i> Enviar mensagem de teste';
  }
</script>

<%- include('../partials/footer') %>
