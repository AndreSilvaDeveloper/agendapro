<%- include('../partials/head', { pageTitle: (typeof editing !== 'undefined' && editing) ? 'Editar Membro' : 'Novo Membro' }) %>
<%- include('../partials/sidebar', { activePage: 'equipe' }) %>

<div style="max-width: 700px;">
  <div class="flex items-center gap-3 mb-6">
    <a href="/admin/equipe" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h1><%= (typeof editing !== 'undefined' && editing) ? 'Editar Membro' : 'Novo Membro' %></h1>
  </div>

  <div class="card">
    <div class="card-body">
      <form action="<%= (typeof editing !== 'undefined' && editing) ? '/admin/equipe/' + staffMember.id + '/editar' : '/admin/equipe/novo' %>" method="POST" enctype="multipart/form-data">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Nome</label>
            <input type="text" name="name" required value="<%= (typeof staffMember !== 'undefined' && staffMember) ? staffMember.name : '' %>" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Telefone / WhatsApp</label>
            <input type="text" name="phone" placeholder="(32) 99999-9999" value="<%= (typeof staffMember !== 'undefined' && staffMember && staffMember.phone) ? staffMember.phone : '' %>" class="form-control">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Foto</label>
            <input type="file" name="staffPhoto" accept="image/*" class="form-control">
            <% if (typeof staffMember !== 'undefined' && staffMember && staffMember.imageUrl) { %>
              <input type="hidden" name="oldImageUrl" value="<%= staffMember.imageUrl %>">
              <img src="<%= staffMember.imageUrl %>" style="width:48px; height:48px; border-radius:50%; object-fit:cover; margin-top:8px;">
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Servicos que realiza</label>
          <div class="flex gap-3" style="flex-wrap: wrap;">
            <% if (typeof availableServices !== 'undefined' && availableServices) { %>
              <% availableServices.forEach(function(svc) { %>
                <%
                  var isChecked = false;
                  if (typeof staffMember !== 'undefined' && staffMember && staffMember.Services) {
                    isChecked = staffMember.Services.some(function(s) { return s.id === svc.id; });
                  }
                %>
                <label class="flex items-center gap-2 cursor-pointer text-sm">
                  <input type="checkbox" name="services" value="<%= svc.id %>" <%= isChecked ? 'checked' : '' %>>
                  <%= svc.name %>
                </label>
              <% }); %>
            <% } %>
          </div>
        </div>

        <div class="divider"></div>
        <h3 class="mb-4">Horarios de Trabalho</h3>

        <%
          var dayNames = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
          var dayLabels = {Monday:'Segunda',Tuesday:'Terca',Wednesday:'Quarta',Thursday:'Quinta',Friday:'Sexta',Saturday:'Sabado',Sunday:'Domingo'};
          var wh = (typeof staffMember !== 'undefined' && staffMember && staffMember.workingHours) ? staffMember.workingHours : {};
        %>

        <% dayNames.forEach(function(day) {
          var dayLower = day.toLowerCase();
          var dayData = wh[dayLower] || wh[day] || {startTime1:'08:00', endTime1:'12:00', startTime2:'13:00', endTime2:'18:00', isOff:false};
          if (day === 'Saturday' && !wh[dayLower] && !wh[day]) { dayData = {startTime1:'08:00', endTime1:'14:00', startTime2:'', endTime2:'', isOff:false}; }
          if (day === 'Sunday' && !wh[dayLower] && !wh[day]) { dayData = {startTime1:'', endTime1:'', startTime2:'', endTime2:'', isOff:true}; }
        %>
          <div class="card mb-3" style="padding: 12px 16px;">
            <div class="flex items-center justify-between mb-2">
              <span class="font-semibold text-sm"><%= dayLabels[day] %></span>
              <label class="flex items-center gap-2 cursor-pointer text-sm">
                <input type="checkbox" name="workingHours[<%= dayLower %>][isOff]" class="day-off-toggle" data-day="<%= day %>" <%= dayData.isOff ? 'checked' : '' %>>
                Folga
              </label>
            </div>
            <div class="form-row" id="hours-<%= day %>" style="<%= dayData.isOff ? 'opacity:0.3; pointer-events:none;' : '' %>">
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Inicio 1</label>
                <input type="time" name="workingHours[<%= dayLower %>][startTime1]" value="<%= dayData.startTime1 || '' %>" class="form-control">
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Fim 1</label>
                <input type="time" name="workingHours[<%= dayLower %>][endTime1]" value="<%= dayData.endTime1 || '' %>" class="form-control">
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Inicio 2</label>
                <input type="time" name="workingHours[<%= dayLower %>][startTime2]" value="<%= dayData.startTime2 || '' %>" class="form-control">
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Fim 2</label>
                <input type="time" name="workingHours[<%= dayLower %>][endTime2]" value="<%= dayData.endTime2 || '' %>" class="form-control">
              </div>
            </div>
          </div>
        <% }); %>

        <div class="form-group mt-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="isActive" <%= (typeof staffMember !== 'undefined' && staffMember && staffMember.isActive) || (typeof editing === 'undefined' || !editing) ? 'checked' : '' %>>
            <span class="form-label" style="margin:0;">Ativo</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg"><i class="fas fa-save"></i> Salvar</button>
      </form>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.day-off-toggle').forEach(function(cb) {
    cb.addEventListener('change', function() {
      var hours = document.getElementById('hours-' + this.dataset.day);
      if (hours) {
        hours.style.opacity = this.checked ? '0.3' : '1';
        hours.style.pointerEvents = this.checked ? 'none' : '';
      }
    });
  });
</script>

<%- include('../partials/footer') %>
