<!-- SCRIPTS                                                          -->
<!-- ================================================================ -->
<script>
// Navegacao entre secoes
function showSection(name) {
  ['plano', 'pagamento', 'historico'].forEach(function(s) {
    document.getElementById('section-' + s).style.display = s === name ? 'block' : 'none';
    document.getElementById('ptab-' + s).classList.toggle('active', s === name);
  });
}

// Auto-abrir pagamento se bloqueado
<% if (blocked && pendingPayment) { %>
  document.addEventListener('DOMContentLoaded', function() { showSection('pagamento'); });
<% } %>

// Tabs de pagamento PIX/Boleto
function showPaymentTab(tab) {
  document.getElementById('panel-pix').style.display = tab === 'pix' ? 'block' : 'none';
  document.getElementById('panel-boleto').style.display = tab === 'boleto' ? 'block' : 'none';
  document.getElementById('tab-pix').classList.toggle('active', tab === 'pix');
  document.getElementById('tab-boleto').classList.toggle('active', tab === 'boleto');
}

function copyField(id, msg) {
  var el = document.getElementById(id);
  if (el) {
    el.select();
    el.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(el.value).then(function() { alert(msg); });
  }
}

function openCardModal(planId, planName, planPrice) {
  document.getElementById('cardPlanId').value = planId;
  document.getElementById('cardPlanInfo').innerHTML = '<span class="text-sm text-secondary">Plano:</span> <strong>' + planName + '</strong> - R$ ' + planPrice + '/mes';
  document.getElementById('cardModal').style.display = 'flex';
}
function closeCardModal() { document.getElementById('cardModal').style.display = 'none'; }

function formatCardNumber(el) {
  var v = el.value.replace(/\D/g, '').substring(0, 16);
  el.value = v.replace(/(\d{4})(?=\d)/g, '$1 ');
}
function formatCpf(el) {
  var v = el.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 9) v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
  else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
  else if (v.length > 3) v = v.replace(/(\d{3})(\d{1,3})/, '$1.$2');
  el.value = v;
}

document.getElementById('cardModal')?.addEventListener('click', function(e) {
  if (e.target === this) closeCardModal();
});
</script>

