<%- include('../partials/head', { pageTitle: 'Equipe' }) %>
<%- include('../partials/sidebar', { activePage: 'equipe' }) %>

<div class="flex items-center justify-between mb-6">
  <h1>Equipe</h1>
  <a href="/admin/equipe/novo" class="btn btn-primary"><i class="fas fa-plus"></i> Novo Membro</a>
</div>

<div class="card">
  <% if (!staffList || staffList.length === 0) { %>
    <div class="empty-state"><i class="fas fa-user-tie"></i><p>Nenhum membro na equipe.</p></div>
  <% } else { %>
    <div class="table-container">
      <table>
        <thead><tr><th>Profissional</th><th>Servicos</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% staffList.forEach(function(s) { %>
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <% if (s.imageUrl) { %>
                    <img src="<%= s.imageUrl %>" style="width:36px; height:36px; border-radius:50%; object-fit:cover;">
                  <% } else { %>
                    <div class="list-item-avatar avatar-primary"><i class="fas fa-user"></i></div>
                  <% } %>
                  <span class="font-medium"><%= s.name %></span>
                </div>
              </td>
              <td>
                <% if (s.Services && s.Services.length > 0) { %>
                  <% s.Services.slice(0,3).forEach(function(svc) { %><span class="tag"><%= svc.name %></span> <% }); %>
                  <% if (s.Services.length > 3) { %><span class="tag">+<%= s.Services.length - 3 %></span><% } %>
                <% } else { %><span class="text-muted text-sm">-</span><% } %>
              </td>
              <td><span class="badge <%= s.isActive ? 'badge-success' : 'badge-neutral' %>"><%= s.isActive ? 'Ativo' : 'Inativo' %></span></td>
              <td class="text-right">
                <a href="/admin/equipe/<%= s.id %>/editar" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></a>
                <form action="/admin/equipe/<%= s.id %>/deletar" method="POST" onsubmit="return confirm('Excluir?')" style="display:inline; margin:0;">
                  <button class="btn btn-ghost btn-sm" style="color:var(--danger);"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
