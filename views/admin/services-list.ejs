<%- include('../partials/head', { pageTitle: 'Servicos' }) %>
<%- include('../partials/sidebar', { activePage: 'servicos' }) %>

<div class="flex items-center justify-between mb-6">
  <h1>Servicos</h1>
  <a href="/admin/servicos/novo" class="btn btn-primary"><i class="fas fa-plus"></i> Novo Servico</a>
</div>

<div class="card">
  <% if (!services || services.length === 0) { %>
    <div class="empty-state"><i class="fas fa-cut"></i><p>Nenhum servico cadastrado.</p></div>
  <% } else { %>
    <div class="table-container">
      <table>
        <thead>
          <tr><th>Nome</th><th>Preco</th><th>Duracao</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% services.forEach(function(s) { %>
            <tr>
              <td class="font-medium"><%= s.name %></td>
              <td>R$ <%= parseFloat(s.price).toFixed(2).replace('.', ',') %></td>
              <td><%= s.duration %> min</td>
              <td><span class="badge <%= s.isActive ? 'badge-success' : 'badge-neutral' %>"><%= s.isActive ? 'Ativo' : 'Inativo' %></span></td>
              <td class="text-right">
                <a href="/admin/servicos/<%= s.id %>/editar" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></a>
                <form action="/admin/servicos/<%= s.id %>/deletar" method="POST" onsubmit="return confirm('Excluir?')" style="display:inline; margin:0;">
                  <button class="btn btn-ghost btn-sm" style="color:var(--danger);"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
