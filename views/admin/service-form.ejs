<%- include('../partials/head', { pageTitle: (typeof editing !== 'undefined' && editing) ? 'Editar Servico' : 'Novo Servico' }) %>
<%- include('../partials/sidebar', { activePage: 'servicos' }) %>

<div style="max-width: 600px;">
  <div class="flex items-center gap-3 mb-6">
    <a href="/admin/servicos" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h1><%= (typeof editing !== 'undefined' && editing) ? 'Editar Servico' : 'Novo Servico' %></h1>
  </div>

  <div class="card">
    <div class="card-body">
      <form action="<%= (typeof editing !== 'undefined' && editing) ? '/admin/servicos/' + service.id + '/editar' : '/admin/servicos/novo' %>" method="POST">
        <div class="form-group">
          <label class="form-label">Nome</label>
          <input type="text" name="name" required value="<%= (typeof service !== 'undefined' && service) ? service.name : '' %>" class="form-control">
        </div>
        <div class="form-group">
          <label class="form-label">Descricao</label>
          <textarea name="description" class="form-control"><%= (typeof service !== 'undefined' && service) ? (service.description || '') : '' %></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Preco (R$)</label>
            <input type="text" name="price" required value="<%= (typeof service !== 'undefined' && service) ? service.price : '' %>" placeholder="0,00" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Duracao (min)</label>
            <input type="number" name="duration" required value="<%= (typeof service !== 'undefined' && service) ? service.duration : '' %>" placeholder="30" class="form-control">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">URL da Imagem (opcional)</label>
          <input type="text" name="imageUrl" value="<%= (typeof service !== 'undefined' && service) ? (service.imageUrl || '') : '' %>" class="form-control">
        </div>
        <div class="form-group">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="isActive" <%= (typeof service !== 'undefined' && service && service.isActive) || (typeof editing === 'undefined' || !editing) ? 'checked' : '' %>>
            <span class="form-label" style="margin:0;">Ativo</span>
          </label>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg"><i class="fas fa-save"></i> Salvar</button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
