<%- include('../partials/head', { pageTitle: 'Cadastro - ' + (typeof orgName !== 'undefined' ? orgName : 'AgendaPro') }) %>
<body class="auth-page">
  <div style="width: 100%; max-width: 420px;">
    <div class="auth-card animate-fade-in">
      <div class="auth-header">
        <i class="fas fa-user-plus" style="font-size: 2rem; margin-bottom: 12px;"></i>
        <h1>Criar Conta</h1>
        <p><%= typeof orgName !== 'undefined' ? orgName : 'AgendaPro' %></p>
      </div>
      <div class="auth-body">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>
        <form action="/portal/<%= orgId %>/registro" method="POST">
          <div class="form-group">
            <label class="form-label">Nome completo</label>
            <input type="text" name="name" required class="form-control" autofocus>
          </div>
          <div class="form-group">
            <label class="form-label">E-mail</label>
            <input type="email" name="email" required class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Telefone (opcional)</label>
            <input type="text" name="phone" class="form-control" placeholder="(11) 99999-9999">
          </div>
          <div class="form-group">
            <label class="form-label">Senha</label>
            <input type="password" name="password" required class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Confirmar senha</label>
            <input type="password" name="confirmPassword" required class="form-control">
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block"><i class="fas fa-user-plus"></i> Criar conta</button>
        </form>
      </div>
      <div class="auth-footer">
        Ja tem conta? <a href="/portal/<%= orgId %>/login">Fazer login</a>
      </div>
    </div>
  </div>
</body>
</html>
