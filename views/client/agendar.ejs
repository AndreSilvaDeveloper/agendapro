<%- include('../partials/head', { pageTitle: 'Novo Agendamento - ' + (typeof orgName !== 'undefined' ? orgName : '') }) %>
<body style="background: var(--bg-body); color: var(--text-primary);">
  <header style="background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 0 20px; height: 56px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:30;">
    <div class="flex items-center gap-3">
      <a href="/portal/minha-area" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
      <span class="font-bold">Novo Agendamento</span>
    </div>
  </header>

  <main style="max-width: 500px; margin: 0 auto; padding: 24px 16px;">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <div class="card">
      <div class="card-header" style="background: var(--primary); color: #fff; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
        <h3 style="color:#fff;"><i class="fas fa-calendar-plus" style="margin-right:8px;"></i> Agendar</h3>
      </div>
      <div class="card-body">
        <form action="/portal/agendar" method="POST" id="bookingForm">
          <!-- Step 1: Servico -->
          <div class="form-group">
            <label class="form-label">1. Escolha o servico</label>
            <select id="serviceSelect" name="serviceId" required class="form-control">
              <option value="">Selecione...</option>
              <% if (typeof services !== 'undefined' && services) { %>
                <% services.forEach(function(s) { %>
                  <option value="<%= s.id %>" data-price="<%= s.price %>" data-duration="<%= s.duration %>">
                    <%= s.name %> - R$ <%= parseFloat(s.price).toFixed(2) %> (<%= s.duration %>min)
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <!-- Step 2: Profissional -->
          <div class="form-group">
            <label class="form-label">2. Escolha o profissional</label>
            <select id="staffSelect" name="staffId" required class="form-control" disabled>
              <option value="">Selecione o servico primeiro</option>
            </select>
          </div>

          <!-- Step 3: Data -->
          <div class="form-group">
            <label class="form-label">3. Data</label>
            <input type="date" id="dateInput" name="date" required class="form-control" disabled>
          </div>

          <!-- Step 4: Horario -->
          <div class="form-group">
            <label class="form-label">4. Horario disponivel</label>
            <select id="timeSelect" name="time" required class="form-control" disabled>
              <option value="">Selecione a data primeiro</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg mt-4" id="submitBtn" disabled>
            <i class="fas fa-calendar-check"></i> Confirmar Agendamento
          </button>
        </form>
      </div>
    </div>

    <div class="alert alert-info mt-4">
      <i class="fas fa-info-circle"></i>
      <span>Agendamentos ficam como <strong>pendentes</strong> ate serem confirmados pelo salao.</span>
    </div>
  </main>

  <script>
    var svcSel = document.getElementById('serviceSelect');
    var staffSel = document.getElementById('staffSelect');
    var dateIn = document.getElementById('dateInput');
    var timeSel = document.getElementById('timeSelect');
    var submitBtn = document.getElementById('submitBtn');

    svcSel.addEventListener('change', async function() {
      staffSel.disabled = true; staffSel.innerHTML = '<option>Carregando...</option>';
      dateIn.disabled = true; dateIn.value = '';
      timeSel.disabled = true; timeSel.innerHTML = '<option value="">-</option>';
      submitBtn.disabled = true;
      if (!this.value) return;

      try {
        var res = await fetch('/api/portal/staff-by-service/' + this.value);
        var staff = await res.json();
        staffSel.innerHTML = '<option value="">Selecione...</option>';
        staff.forEach(function(s) { var o = document.createElement('option'); o.value = s.id; o.textContent = s.name; staffSel.appendChild(o); });
        staffSel.disabled = false;
      } catch(e) { staffSel.innerHTML = '<option>Erro</option>'; }
    });

    staffSel.addEventListener('change', function() {
      dateIn.disabled = !this.value;
      timeSel.disabled = true; timeSel.innerHTML = '<option value="">Selecione a data</option>';
      submitBtn.disabled = true;
      if (this.value) dateIn.min = new Date().toISOString().split('T')[0];
    });

    dateIn.addEventListener('change', async function() {
      timeSel.disabled = true; timeSel.innerHTML = '<option>Carregando...</option>';
      submitBtn.disabled = true;
      if (!this.value) return;

      try {
        var res = await fetch('/api/portal/available-times?staffId=' + staffSel.value + '&date=' + this.value + '&serviceId=' + svcSel.value);
        var times = await res.json();
        timeSel.innerHTML = '<option value="">Selecione...</option>';
        if (times.length === 0) {
          timeSel.innerHTML = '<option value="">Sem horarios disponiveis</option>';
        } else {
          times.forEach(function(t) { var o = document.createElement('option'); o.value = t; o.textContent = t; timeSel.appendChild(o); });
          timeSel.disabled = false;
        }
      } catch(e) { timeSel.innerHTML = '<option>Erro</option>'; }
    });

    timeSel.addEventListener('change', function() {
      submitBtn.disabled = !this.value;
    });
  </script>
</body>
</html>
