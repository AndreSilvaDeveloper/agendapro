<%- include('../partials/head', { pageTitle: 'Minha Area - ' + (typeof orgName !== 'undefined' ? orgName : '') }) %>
<body style="background: var(--bg-body); color: var(--text-primary);">
  <!-- Header simples -->
  <header style="background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 0 20px; height: 56px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:30;">
    <div class="flex items-center gap-3">
      <i class="fas fa-calendar-check" style="color: var(--primary);"></i>
      <span class="font-bold"><%= typeof orgName !== 'undefined' ? orgName : 'AgendaPro' %></span>
    </div>
    <div class="flex items-center gap-3">
      <a href="/portal/agendar" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Agendar</a>
      <a href="/portal/logout" class="btn btn-ghost btn-sm" style="color: var(--danger);"><i class="fas fa-sign-out-alt"></i></a>
    </div>
  </header>

  <main style="max-width: 800px; margin: 0 auto; padding: 24px 16px;">
    <!-- Saudacao -->
    <div class="card mb-6" style="background: var(--primary); color: #fff;">
      <div class="card-body">
        <h1 style="color: #fff;">Ola, <%= typeof clientName !== 'undefined' ? clientName : 'Cliente' %>!</h1>
        <p style="opacity: 0.85;">Bem-vindo(a) a sua area no <%= typeof orgName !== 'undefined' ? orgName : 'AgendaPro' %></p>
      </div>
    </div>

    <!-- Proximos agendamentos -->
    <div class="card mb-6">
      <div class="card-header">
        <h3><i class="fas fa-calendar-day" style="color: var(--primary); margin-right: 8px;"></i> Proximos Agendamentos</h3>
      </div>
      <% if (typeof proximosAgendamentos === 'undefined' || !proximosAgendamentos || proximosAgendamentos.length === 0) { %>
        <div class="empty-state"><i class="fas fa-calendar-check"></i><p>Nenhum agendamento futuro.</p></div>
      <% } else { %>
        <% proximosAgendamentos.forEach(function(a) { %>
          <div class="list-item">
            <div class="list-item-avatar avatar-primary"><i class="fas fa-clock"></i></div>
            <div class="flex-1">
              <div class="font-semibold"><%= a.date %> as <%= a.time %></div>
              <div class="text-xs text-secondary">
                <% if (a.services) { %><%= a.services %><% } %>
                <% if (a.staffName) { %> | <%= a.staffName %><% } %>
              </div>
            </div>
            <span class="badge badge-<%= a.status === 'confirmado' ? 'success' : a.status === 'pendente' ? 'warning' : 'neutral' %>">
              <%= a.status %>
            </span>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Historico -->
    <div class="card mb-6">
      <div class="card-header"><h3><i class="fas fa-history" style="margin-right: 8px;"></i> Historico</h3></div>
      <% if (typeof historicoAgendamentos === 'undefined' || !historicoAgendamentos || historicoAgendamentos.length === 0) { %>
        <div class="empty-state" style="padding: 20px;"><p class="text-sm">Nenhum historico.</p></div>
      <% } else { %>
        <div style="max-height: 300px; overflow-y: auto;" class="custom-scroll">
          <% historicoAgendamentos.forEach(function(a) { %>
            <div class="list-item" style="opacity: 0.7;">
              <div class="flex-1">
                <div class="text-sm font-medium"><%= a.date %> - <%= a.time %></div>
                <div class="text-xs text-secondary"><%= a.services || '' %></div>
              </div>
              <span class="badge badge-neutral"><%= a.status %></span>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Produtos pendentes -->
    <% if (typeof produtosPendentes !== 'undefined' && produtosPendentes && produtosPendentes.length > 0) { %>
      <div class="card mb-6">
        <div class="card-header"><h3><i class="fas fa-box" style="color: var(--warning); margin-right: 8px;"></i> Produtos Pendentes</h3></div>
        <% produtosPendentes.forEach(function(p) { %>
          <div class="list-item">
            <div class="flex-1">
              <div class="font-medium"><%= p.name %></div>
              <div class="text-xs text-secondary">R$ <%= parseFloat(p.price).toFixed(2) %></div>
            </div>
            <span class="badge badge-warning">Pendente</span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
      Swal.fire({
        title: 'Atualizacoes',
        html: '<%- notifications.map(function(n) { return "<p>" + n + "</p>"; }).join("") %>',
        icon: 'info',
        confirmButtonColor: '#4F46E5'
      });
    <% } %>
  </script>
</body>
</html>
