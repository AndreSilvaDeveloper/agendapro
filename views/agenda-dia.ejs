<%- include('partials/head', { pageTitle: 'Agenda Semanal' }) %>
<%- include('partials/sidebar', { activePage: 'agenda' }) %>

<div class="grid grid-12" style="gap: 24px;">
  <!-- Sidebar filtro -->
  <div class="col-span-3 flex flex-col gap-4">
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-filter" style="color:var(--primary); margin-right:8px;"></i> Filtrar</h3></div>
      <div class="card-body">
        <form method="GET" action="/agendamentos-por-dia">
          <div class="form-group">
            <label class="form-label">Data</label>
            <input id="dateInput" type="date" name="date"
              value="<%= (typeof date !== 'undefined' && date) ? date : '' %>"
              class="form-control">
          </div>
          <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-search"></i> Buscar</button>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3><i class="fas fa-chart-pie" style="color:var(--primary); margin-right:8px;"></i> Resumo</h3></div>
      <div class="card-body">
        <%
          var totalAg = 0, totalLivres = 0;
          if (typeof days !== 'undefined' && days) {
            days.forEach(function(d) {
              var key = d.format('YYYY-MM-DD');
              totalAg += (typeof resultsByDay !== 'undefined' && resultsByDay[key]) ? resultsByDay[key].length : 0;
              totalLivres += (typeof availableByDay !== 'undefined' && availableByDay[key]) ? availableByDay[key].length : 0;
            });
          }
          var ocup = totalAg + totalLivres > 0 ? Math.round((totalAg / (totalAg + totalLivres)) * 100) : 0;
        %>
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-secondary">Agendados</span>
            <span class="font-bold" style="color: var(--info);"><%= totalAg %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-secondary">Livres</span>
            <span class="font-bold text-success"><%= totalLivres %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-secondary">Ocupacao</span>
            <span class="font-bold"><%= ocup %>%</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dias da semana -->
  <div class="col-span-9 flex flex-col gap-4">
    <%
      var weekdayMap = { Monday: 'Segunda', Tuesday: 'Terca', Wednesday: 'Quarta', Thursday: 'Quinta', Friday: 'Sexta', Saturday: 'Sabado', Sunday: 'Domingo' };
      var today = new Date(); today.setHours(0,0,0,0);
    %>

    <% if (typeof days !== 'undefined' && days && days.length > 0) { %>
      <% days.forEach(function(d) {
        var key = d.format('YYYY-MM-DD');
        var dayDate = new Date(key + 'T00:00:00');
        var isToday = dayDate.toDateString() === today.toDateString();
        var agList = (typeof resultsByDay !== 'undefined' && resultsByDay[key]) ? resultsByDay[key] : [];
        var livList = (typeof availableByDay !== 'undefined' && availableByDay[key]) ? availableByDay[key] : [];
      %>
        <div class="card">
          <div class="card-header" style="<%= isToday ? 'background: var(--primary-50);' : '' %>">
            <div class="flex items-center gap-3">
              <div style="text-align:center; min-width:40px;">
                <div class="text-xs text-secondary font-bold"><%= d.format('MMM').toUpperCase() %></div>
                <div class="font-bold" style="font-size:1.3rem; <%= isToday ? 'color: var(--primary);' : '' %>"><%= d.format('DD') %></div>
              </div>
              <div>
                <span class="font-semibold"><%= weekdayMap[d.format('dddd')] || d.format('dddd') %></span>
                <% if (isToday) { %><span class="badge badge-info" style="margin-left:8px;">Hoje</span><% } %>
              </div>
            </div>
            <span class="badge <%= agList.length > 0 ? 'badge-info' : 'badge-neutral' %>"><%= agList.length %> agend.</span>
          </div>

          <div class="card-body">
            <div class="grid grid-2" style="gap: 24px;">
              <!-- Agendados -->
              <div>
                <div class="text-xs font-bold text-muted mb-2"><i class="fas fa-list" style="margin-right:4px;"></i> AGENDADOS</div>
                <% if (agList.length > 0) { %>
                  <div class="flex flex-col gap-2">
                    <% agList.forEach(function(r) { %>
                      <div class="appt-card appt-status-<%= r.status || 'confirmado' %>">
                        <div class="appt-time"><%= r.timeFormatted %></div>
                        <div class="flex-1" style="min-width:0;">
                          <a href="/client/<%= r.clientId %>" class="font-semibold truncate block" style="text-decoration:none; color:inherit;"><%= r.clientName %></a>
                          <div class="text-xs text-secondary truncate"><%= r.servicesNames || 'Servico' %></div>
                        </div>
                        <div class="flex gap-1">
                          <% if (r.status === 'pendente') { %>
                            <form action="/admin/appointment/<%= r.id %>/confirm" method="POST" style="margin:0;">
                              <button class="btn btn-success btn-sm" style="padding:4px 8px;" title="Confirmar"><i class="fas fa-check"></i></button>
                            </form>
                          <% } %>
                          <form action="/admin/appointment/<%= r.id %>/cancel-by-admin" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este agendamento?')" style="margin:0;">
                            <button class="btn btn-danger btn-sm" style="padding:4px 8px;" title="Excluir"><i class="fas fa-trash"></i></button>
                          </form>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="empty-state" style="padding: 20px;"><p class="text-sm">Livre</p></div>
                <% } %>
              </div>

              <!-- Disponiveis -->
              <div>
                <div class="text-xs font-bold text-muted mb-2"><i class="fas fa-plus-circle" style="margin-right:4px;"></i> DISPONIVEIS</div>
                <% if (livList.length > 0) { %>
                  <div class="flex gap-2" style="flex-wrap:wrap;">
                    <% livList.forEach(function(t) { %>
                      <button onclick="abrirModal('<%= key %>', '<%= t %>')" class="btn btn-outline btn-sm" style="color: var(--success); border-color: var(--success);">
                        <%= t %>
                      </button>
                    <% }); %>
                  </div>
                <% } else { %>
                  <span class="badge badge-danger">Lotado</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="empty-state card" style="padding: 60px;"><i class="far fa-calendar-times"></i><p>Selecione uma data para ver a agenda.</p></div>
    <% } %>
  </div>
</div>

<!-- Modal novo agendamento -->
<div id="modalAgendamento" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:100; align-items:center; justify-content:center; padding:16px;">
  <div class="card" style="max-width:500px; width:100%;">
    <div class="card-header" style="background:var(--primary); color:#fff; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
      <h3 style="color:#fff;"><i class="fas fa-calendar-plus" style="margin-right:8px;"></i> Novo Agendamento</h3>
      <button onclick="fecharModal()" class="btn btn-ghost btn-sm" style="color:#fff;"><i class="fas fa-times"></i></button>
    </div>
    <div class="card-body">
      <form action="/appointment" method="POST" id="modalForm">
        <input type="hidden" id="modalDate" name="date">
        <input type="hidden" id="modalTime" name="time">

        <div class="form-group" style="position:relative;">
          <label class="form-label">Cliente</label>
          <input type="text" id="clientSearch" class="form-control" placeholder="Buscar cliente..." autocomplete="off">
          <input type="hidden" name="clientId" id="clientId">
          <ul id="clientSuggestions" style="position:absolute; left:0; right:0; z-index:50; max-height:200px; overflow-y:auto; display:none; background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius); box-shadow:var(--shadow-lg); list-style:none; padding:0; margin-top:2px;"></ul>
        </div>

        <div class="form-group">
          <label class="form-label">Servico</label>
          <select id="serviceSelect" class="form-control" required>
            <option value="">Selecione...</option>
            <% if (typeof services !== 'undefined' && services) { %>
              <% services.forEach(function(s) { %>
                <option value="<%= s.id %>" data-name="<%= s.name %>" data-price="<%= s.price %>" data-duration="<%= s.duration %>"><%= s.name %> - R$ <%= s.price %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Preco (R$)</label>
            <input type="number" id="servicePrice" step="0.01" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Duracao (min)</label>
            <input type="number" id="serviceDuration" class="form-control">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Profissional</label>
          <select id="staffId" name="staffId" class="form-control" required>
            <option value="">Selecione o servico primeiro...</option>
          </select>
        </div>

        <input type="hidden" name="services" id="servicesInput">
        <input type="hidden" name="duration" id="durationInput">

        <div class="flex gap-2 mt-4">
          <button type="button" onclick="fecharModal()" class="btn btn-outline flex-1">Cancelar</button>
          <button type="submit" class="btn btn-success flex-1"><i class="fas fa-check"></i> Confirmar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="clients-data" class="hidden" data-clients='<%- JSON.stringify(typeof clients !== "undefined" ? clients : []) %>'></div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Date default
  document.addEventListener('DOMContentLoaded', function() {
    var di = document.getElementById('dateInput');
    if (di && !di.value) di.valueAsDate = new Date();
  });

  // Modal
  var modal = document.getElementById('modalAgendamento');
  var clients = [];
  try { clients = JSON.parse(document.getElementById('clients-data').dataset.clients); } catch(e){}

  function abrirModal(date, time) {
    document.getElementById('modalDate').value = date;
    document.getElementById('modalTime').value = time;
    modal.style.display = 'flex';
  }
  function fecharModal() { modal.style.display = 'none'; }

  // Client search
  var cs = document.getElementById('clientSearch');
  var sg = document.getElementById('clientSuggestions');
  cs.addEventListener('input', function() {
    var v = this.value.toLowerCase();
    sg.innerHTML = '';
    if (v.length < 2) { sg.style.display = 'none'; return; }
    var f = clients.filter(function(c) { return c.name.toLowerCase().includes(v) || (c.phone && c.phone.includes(v)); });
    if (f.length > 0) {
      sg.style.display = 'block';
      f.forEach(function(c) {
        var li = document.createElement('li');
        li.style.padding = '10px 12px'; li.style.cursor = 'pointer'; li.style.borderBottom = '1px solid var(--border-light)';
        li.textContent = c.name;
        li.onmouseenter = function() { this.style.background = 'var(--bg-hover)'; };
        li.onmouseleave = function() { this.style.background = ''; };
        li.onclick = function() { cs.value = c.name; document.getElementById('clientId').value = c.id; sg.style.display = 'none'; };
        sg.appendChild(li);
      });
    } else sg.style.display = 'none';
  });

  // Service select -> load staff
  var svcSel = document.getElementById('serviceSelect');
  var staffSel = document.getElementById('staffId');
  svcSel.addEventListener('change', async function() {
    var opt = this.selectedOptions[0];
    if (opt) {
      document.getElementById('servicePrice').value = opt.dataset.price;
      document.getElementById('serviceDuration').value = opt.dataset.duration;
    }
    staffSel.innerHTML = '<option>Carregando...</option>';
    if (!this.value) return;
    try {
      var res = await fetch('/api/admin/staff-by-service/' + this.value);
      var staff = await res.json();
      staffSel.innerHTML = '<option value="">Selecione...</option>';
      staff.forEach(function(s) { var o = document.createElement('option'); o.value = s.id; o.textContent = s.name; staffSel.appendChild(o); });
    } catch(e) { staffSel.innerHTML = '<option value="">Erro</option>'; }
  });

  // Form submit
  document.getElementById('modalForm').addEventListener('submit', function(e) {
    if (!document.getElementById('clientId').value) { e.preventDefault(); alert('Selecione um cliente.'); return; }
    var opt = svcSel.selectedOptions[0];
    var price = document.getElementById('servicePrice').value;
    var dur = document.getElementById('serviceDuration').value;
    var data = [{id: svcSel.value, name: opt.dataset.name || opt.text, price: parseFloat(price), duration: parseInt(dur)}];
    document.getElementById('servicesInput').value = JSON.stringify(data);
    document.getElementById('durationInput').value = dur;
  });
</script>

<%- include('partials/footer') %>
