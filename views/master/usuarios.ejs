<%- include('../partials/head', { pageTitle: 'Usuarios - Master' }) %>
<%- include('../partials/master-sidebar', { path: 'usuarios' }) %>

<div class="flex items-center justify-between mb-6">
  <h1>Usuarios</h1>
  <span class="badge badge-neutral text-sm"><%= users.length %> encontrados</span>
</div>

<!-- Filters -->
<div class="card mb-4">
  <div class="card-body compact">
    <form method="GET" action="/master/usuarios" class="flex items-center gap-3 flex-wrap">
      <div class="input-group" style="flex: 1; min-width: 200px;">
        <i class="fas fa-search input-icon"></i>
        <input type="text" name="search" class="form-control" placeholder="Buscar por nome ou email..." value="<%= filters.search %>">
      </div>
      <select name="role" class="form-control" style="width: auto; min-width: 150px;">
        <option value="">Todas as roles</option>
        <option value="owner" <%= filters.role === 'owner' ? 'selected' : '' %>>Owner</option>
        <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
        <option value="staff" <%= filters.role === 'staff' ? 'selected' : '' %>>Staff</option>
        <option value="superadmin" <%= filters.role === 'superadmin' ? 'selected' : '' %>>SuperAdmin</option>
      </select>
      <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter"></i> Filtrar</button>
      <a href="/master/usuarios" class="btn btn-outline btn-sm">Limpar</a>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card">
  <% if (users.length === 0) { %>
    <div class="empty-state" style="padding: 60px 20px; text-align: center;">
      <i class="fas fa-users" style="font-size: 2rem; color: var(--text-muted); margin-bottom: 12px;"></i>
      <p class="text-secondary">Nenhum usuario encontrado.</p>
    </div>
  <% } else { %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Role</th>
            <th>Organizacao</th>
            <th>Status</th>
            <th>Criado em</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(user) { %>
            <tr>
              <td class="text-sm text-secondary"><%= user.id %></td>
              <td class="font-medium"><%= user.username %></td>
              <td class="text-sm"><%= user.email %></td>
              <td>
                <% if (user.role === 'superadmin') { %>
                  <span class="badge badge-warning"><i class="fas fa-crown"></i> SuperAdmin</span>
                <% } else if (user.role === 'owner') { %>
                  <span class="badge badge-info">Owner</span>
                <% } else if (user.role === 'admin') { %>
                  <span class="badge badge-neutral">Admin</span>
                <% } else { %>
                  <span class="badge badge-neutral"><%= user.role %></span>
                <% } %>
              </td>
              <td class="text-sm">
                <% if (user.Organization) { %>
                  <a href="/master/impersonate/<%= user.Organization.id %>" class="text-primary"><%= user.Organization.name %></a>
                <% } else { %>
                  <span class="text-secondary">-</span>
                <% } %>
              </td>
              <td>
                <% if (user.isBlocked) { %>
                  <span class="badge badge-danger"><i class="fas fa-ban"></i> Bloqueado</span>
                <% } else { %>
                  <span class="badge badge-success">Ativo</span>
                <% } %>
              </td>
              <td class="text-sm text-secondary">
                <%= new Date(user.createdAt).toLocaleDateString('pt-BR') %>
              </td>
              <td class="text-right">
                <% if (user.role !== 'superadmin') { %>
                  <div class="flex gap-1 justify-end">
                    <% if (user.isBlocked) { %>
                      <form action="/master/user/<%= user.id %>/unblock" method="POST" style="margin:0;">
                        <button class="btn btn-success btn-sm" title="Desbloquear"><i class="fas fa-unlock"></i></button>
                      </form>
                    <% } else { %>
                      <form action="/master/user/<%= user.id %>/block" method="POST" onsubmit="return confirm('Bloquear este usuario?')" style="margin:0;">
                        <button class="btn btn-danger btn-sm" title="Bloquear"><i class="fas fa-ban"></i></button>
                      </form>
                    <% } %>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
