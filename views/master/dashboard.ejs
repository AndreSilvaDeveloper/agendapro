<%- include('../partials/head', { pageTitle: 'Painel Master' }) %>
<%- include('../partials/master-sidebar', { path: 'dashboard' }) %>

<h1 class="mb-6">Painel Master</h1>

<!-- Stats -->
<div class="grid grid-4 mb-6">
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Total Organizacoes</div>
        <div class="stat-value" style="color: var(--primary);"><%= typeof stats !== 'undefined' ? stats.totalOrgs : 0 %></div>
      </div>
      <div class="stat-icon purple"><i class="fas fa-building"></i></div>
    </div>
  </div>

  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Assinaturas Ativas</div>
        <div class="stat-value text-success"><%= typeof stats !== 'undefined' ? stats.activeSubscriptions : 0 %></div>
      </div>
      <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
    </div>
  </div>

  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Receita Mensal</div>
        <div class="stat-value" style="color: var(--warning);">R$ <%= typeof stats !== 'undefined' ? stats.monthlyRevenue : '0,00' %></div>
      </div>
      <div class="stat-icon yellow"><i class="fas fa-dollar-sign"></i></div>
    </div>
  </div>

  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Novos Este Mes</div>
        <div class="stat-value" style="color: var(--info);"><%= typeof stats !== 'undefined' ? stats.newOrgsThisMonth : 0 %></div>
      </div>
      <div class="stat-icon blue"><i class="fas fa-user-plus"></i></div>
    </div>
  </div>
</div>

<!-- Two columns -->
<div class="grid" style="grid-template-columns: 2fr 1fr; gap: 24px;">
  <!-- Left: Recent Orgs -->
  <div>
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-building" style="color: var(--primary); margin-right: 8px;"></i> Ultimas Organizacoes</h3>
        <a href="/master/organizacoes" class="btn btn-outline btn-sm">Ver todas</a>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>Plano</th>
              <th>Status</th>
              <th>Criado em</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof recentOrgs !== 'undefined' && recentOrgs.length > 0) { %>
              <% recentOrgs.forEach(function(org) { %>
                <tr>
                  <td class="font-medium"><%= org.name %></td>
                  <td>
                    <span class="badge badge-info"><%= org.planName || 'Sem plano' %></span>
                  </td>
                  <td>
                    <% if (org.subscriptionStatus === 'active') { %>
                      <span class="badge badge-success">Ativo</span>
                    <% } else if (org.subscriptionStatus === 'trial') { %>
                      <span class="badge badge-info">Trial</span>
                    <% } else if (org.subscriptionStatus === 'past_due') { %>
                      <span class="badge badge-warning">Inadimplente</span>
                    <% } else if (org.subscriptionStatus === 'canceled') { %>
                      <span class="badge badge-danger">Cancelado</span>
                    <% } else if (org.subscriptionStatus === 'expired') { %>
                      <span class="badge badge-danger">Expirado</span>
                    <% } else { %>
                      <span class="badge badge-neutral"><%= org.subscriptionStatus || 'N/A' %></span>
                    <% } %>
                  </td>
                  <td class="text-sm text-secondary">
                    <%= org.createdAt ? new Date(org.createdAt).toLocaleDateString('pt-BR') : '-' %>
                  </td>
                  <td class="text-right">
                    <div class="flex gap-1 justify-end">
                      <a href="/master/organizacoes/<%= org.id %>" class="btn btn-outline btn-sm" title="Ver detalhes"><i class="fas fa-eye"></i></a>
                      <a href="/master/impersonate/<%= org.id %>" class="btn btn-outline btn-sm" title="Impersonar"><i class="fas fa-sign-in-alt"></i></a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center text-secondary" style="padding: 40px;">
                  Nenhuma organizacao encontrada.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Right column -->
  <div class="flex flex-col gap-4">
    <!-- Revenue by Plan -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-chart-pie" style="color: var(--warning); margin-right: 8px;"></i> Receita por Plano</h3>
      </div>
      <div class="card-body" style="padding: 12px 20px;">
        <% if (typeof revenueByPlan !== 'undefined' && revenueByPlan.length > 0) { %>
          <div class="flex flex-col gap-3">
            <% revenueByPlan.forEach(function(item) { %>
              <div class="flex items-center justify-between" style="padding: 8px 0; border-bottom: 1px solid var(--border-light);">
                <div class="flex items-center gap-2">
                  <i class="fas fa-circle text-xs" style="color: var(--primary); font-size: 0.5rem;"></i>
                  <span class="font-medium text-sm"><%= item.planName %></span>
                </div>
                <span class="font-semibold text-sm">R$ <%= item.revenue %></span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center text-secondary" style="padding: 20px 0;">
            <i class="fas fa-chart-pie" style="font-size: 1.5rem; opacity: 0.3;"></i>
            <p class="text-sm mt-2">Sem dados de receita.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-clock" style="color: var(--info); margin-right: 8px;"></i> Atividade Recente</h3>
      </div>
      <div class="card-body" style="padding: 12px 20px; max-height: 350px; overflow-y: auto;">
        <% if (typeof recentActivity !== 'undefined' && recentActivity.length > 0) { %>
          <div class="flex flex-col gap-3">
            <% recentActivity.forEach(function(item) { %>
              <div class="flex items-start gap-3" style="padding: 8px 0; border-bottom: 1px solid var(--border-light);">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--primary-50); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <i class="fas fa-<%= item.icon || 'bell' %>" style="font-size: 0.75rem; color: var(--primary);"></i>
                </div>
                <div class="flex-1">
                  <div class="text-sm"><%= item.description %></div>
                  <div class="text-xs text-muted mt-1"><%= item.timeAgo %></div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center text-secondary" style="padding: 20px 0;">
            <i class="fas fa-clock" style="font-size: 1.5rem; opacity: 0.3;"></i>
            <p class="text-sm mt-2">Nenhuma atividade recente.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .grid[style*="2fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<%- include('../partials/footer') %>
