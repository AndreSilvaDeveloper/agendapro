<%- include('partials/head', { pageTitle: clientData.name + ' - Detalhes' }) %>
<%- include('partials/sidebar', { activePage: 'clientes' }) %>

<!-- Header do cliente -->
<div class="card mb-6">
  <div class="card-body">
    <div class="flex items-center justify-between" style="flex-wrap: wrap; gap: 16px;">
      <div class="flex items-center gap-4">
        <div class="list-item-avatar avatar-primary" style="width: 56px; height: 56px; font-size: 1.3rem;">
          <i class="fas fa-user"></i>
        </div>
        <div>
          <h1 style="font-size: 1.5rem;"><%= clientData.name %></h1>
          <div class="flex items-center gap-2 text-secondary">
            <i class="fas fa-phone" style="font-size: 0.8rem;"></i>
            <span><%= clientData.phone %></span>
          </div>
          <% if (typeof isHistory !== 'undefined' && isHistory) { %>
            <span class="badge badge-warning mt-2"><i class="fas fa-history"></i> Historico completo</span>
          <% } %>
        </div>
      </div>

      <div class="flex gap-2" style="flex-wrap: wrap;">
        <% if (typeof isHistory === 'undefined' || !isHistory) { %>
          <form action="/client/<%= clientData.id %>/edit" method="POST" onsubmit="return editClient(this, '<%= clientData.name %>', '<%= clientData.phone %>')" style="margin:0;">
            <button class="btn btn-outline btn-sm"><i class="fas fa-edit"></i> Editar</button>
          </form>
          <a href="/client/<%= clientData.id %>/historico" class="btn btn-outline btn-sm"><i class="fas fa-history"></i> Historico</a>
          <form action="/client/<%= clientData.id %>/delete" method="POST" onsubmit="return confirm('Excluir este cliente?')" style="margin:0;">
            <button class="btn btn-outline btn-sm" style="color: var(--danger); border-color: var(--danger);"><i class="fas fa-trash"></i> Excluir</button>
          </form>
        <% } else { %>
          <a href="/client/<%= clientData.id %>" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Voltar</a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-12" style="gap: 24px;">
  <div class="col-span-8 flex flex-col gap-6">

    <% if (typeof isHistory === 'undefined' || !isHistory) { %>
    <!-- Novo Agendamento -->
    <div class="card">
      <div class="card-header" style="background: var(--primary); color: #fff; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
        <h3 style="color:#fff;"><i class="fas fa-calendar-plus" style="margin-right: 8px;"></i> Novo Agendamento</h3>
      </div>
      <div class="card-body">
        <form action="/appointment" method="POST" onsubmit="return processForm()">
          <input type="hidden" name="clientId" value="<%= clientData.id %>">

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Data</label>
              <input type="date" name="date" required class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Horario</label>
              <input type="time" name="time" required class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Profissional</label>
              <select name="staffId" required class="form-control">
                <option value="">Selecione...</option>
                <% if (typeof staff !== 'undefined' && staff.length > 0) { %>
                  <% staff.forEach(function(s) { %>
                    <option value="<%= s.id %>"><%= s.name %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Duracao (min)</label>
              <input type="number" name="duration" placeholder="30" required class="form-control">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Servicos</label>
            <div id="serviceCheckboxes" class="text-sm text-secondary" style="padding: 8px 0;">
              Selecione um profissional para ver os servicos
            </div>
          </div>

          <input type="hidden" name="services" id="servicesInput">
          <input type="hidden" name="products" id="productsInput">

          <button type="submit" class="btn btn-primary btn-block btn-lg">
            <i class="fas fa-calendar-check"></i> Agendar
          </button>
        </form>
      </div>
    </div>

    <!-- Produtos -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-box" style="color: var(--primary); margin-right: 8px;"></i> Produtos</h3>
      </div>
      <div class="card-body">
        <form action="/client/<%= clientData.id %>/add-product" method="POST" class="mb-4">
          <div class="flex gap-2" style="flex-wrap: wrap;">
            <input name="name" type="text" placeholder="Nome do produto" required class="form-control" style="flex:1; min-width: 160px;">
            <input name="price" type="number" step="0.01" placeholder="Preco" required class="form-control" style="width: 120px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Adicionar</button>
          </div>
        </form>

        <% if (clientData.Products && clientData.Products.length) { %>
          <div class="flex flex-col gap-3">
            <% clientData.Products.forEach(function(p) { %>
              <%
                var totalPaid = (p.Payments || []).reduce(function(sum, pay) { return sum + parseFloat(pay.amount); }, 0);
                var remaining = parseFloat(p.price) - totalPaid;
                var isPaid = remaining <= 0;
              %>
              <div class="card">
                <div class="card-body compact">
                  <div class="flex items-center justify-between mb-2" style="flex-wrap: wrap; gap: 8px;">
                    <div>
                      <span class="font-semibold"><%= p.name %></span>
                      <% if (isPaid) { %>
                        <span class="badge badge-success" style="margin-left: 8px;">Pago</span>
                      <% } else { %>
                        <span class="badge badge-warning" style="margin-left: 8px;">Pendente</span>
                      <% } %>
                    </div>
                    <div class="flex gap-1">
                      <form action="/client/<%= clientData.id %>/product/<%= p.id %>/pay" method="POST" onsubmit="return pagarValor(this)" data-remaining="<%= remaining %>" style="margin:0;">
                        <button class="btn btn-success btn-sm"><i class="fas fa-credit-card"></i></button>
                      </form>
                      <form action="/client/<%= clientData.id %>/product/<%= p.id %>/edit" method="POST" onsubmit="return editItem(this, '<%= p.name %>', '<%= p.price %>')" style="margin:0;">
                        <button class="btn btn-outline btn-sm"><i class="fas fa-edit"></i></button>
                      </form>
                      <form action="/client/<%= clientData.id %>/product/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Excluir?')" style="margin:0;">
                        <button class="btn btn-ghost btn-sm" style="color:var(--danger);"><i class="fas fa-trash"></i></button>
                      </form>
                    </div>
                  </div>
                  <div class="text-sm text-secondary">
                    Total: R$ <%= parseFloat(p.price).toFixed(2) %> |
                    Pago: R$ <%= totalPaid.toFixed(2) %>
                    <% if (remaining > 0) { %> | <span class="text-danger font-semibold">Restante: R$ <%= remaining.toFixed(2) %></span><% } %>
                  </div>

                  <% if (p.Payments && p.Payments.length) { %>
                    <div class="divider"></div>
                    <div class="text-xs font-semibold text-secondary mb-2">Pagamentos:</div>
                    <% p.Payments.forEach(function(pay) { %>
                      <div class="flex items-center justify-between text-sm" style="padding: 4px 0; border-bottom: 1px solid var(--border-light);">
                        <span><i class="fas fa-check-circle text-success" style="margin-right:4px;"></i> R$ <%= parseFloat(pay.amount).toFixed(2) %> - <%= new Date(pay.paidAt).toLocaleDateString('pt-BR') %> (<%= pay.method %>)</span>
                        <form action="/client/<%= clientData.id %>/product/<%= p.id %>/remove-payment/<%= pay.id %>" method="POST" onsubmit="return confirm('Excluir pagamento?')" style="margin:0;">
                          <button class="btn btn-ghost btn-sm" style="color:var(--danger); padding:2px 6px;"><i class="fas fa-trash" style="font-size:0.7rem;"></i></button>
                        </form>
                      </div>
                    <% }); %>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-state"><i class="fas fa-box-open"></i><p>Nenhum produto cadastrado.</p></div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Agendamentos -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-calendar-alt" style="color: var(--primary); margin-right: 8px;"></i>
          <% if (typeof isHistory !== 'undefined' && isHistory) { %>Historico<% } else { %>Agendamentos<% } %>
        </h3>
      </div>
      <div class="card-body">
        <%
          var visible;
          if (typeof isHistory !== 'undefined' && isHistory) {
            visible = appointments || [];
          } else {
            visible = (appointments || []).filter(function(a) {
              var parts = a.formatted.split(' ')[0].split('/');
              var apptDate = new Date(parts[2] + '-' + parts[1] + '-' + parts[0] + 'T00:00:00');
              var todayMid = new Date(); todayMid.setHours(0,0,0,0);
              if (apptDate >= todayMid) return true;
              for (var si = 0; si < (a.AppointmentServices || []).length; si++) {
                var s = a.AppointmentServices[si];
                var paid = (s.AppointmentPayments || []).reduce(function(sum, p) { return sum + parseFloat(p.amount); }, 0);
                if (paid < parseFloat(s.price)) return true;
              }
              return false;
            });
          }
        %>

        <% if (visible.length === 0) { %>
          <div class="empty-state"><i class="fas fa-calendar-times"></i><p>Nenhum agendamento encontrado.</p></div>
        <% } else { %>
          <div class="flex flex-col gap-4">
            <% visible.forEach(function(a) {
              var parts2 = a.formatted.split(' ');
              var datePart = parts2[0];
              var timePart = parts2[2] || '';
              var dp = datePart.split('/');
              var apptDate2 = new Date(dp[2] + '-' + dp[1] + '-' + dp[0] + 'T00:00:00');
              var td = new Date(); td.setHours(0,0,0,0);
              var isPast = apptDate2 < td;
            %>
              <div class="card" style="<%= isPast ? 'opacity: 0.7;' : '' %>">
                <div class="card-body compact">
                  <div class="flex items-center justify-between mb-3" style="flex-wrap: wrap; gap: 8px;">
                    <div>
                      <span class="font-semibold"><i class="fas fa-clock" style="color: var(--primary); margin-right: 4px;"></i> <%= a.formatted %> (<%= a.duration %> min)</span>
                      <% if (isPast) { %><span class="badge badge-neutral" style="margin-left:8px;">Passado</span><% } %>
                    </div>
                    <div class="flex gap-1" style="flex-wrap: wrap;">
                      <% if (!isPast) { %>
                        <button type="button" onclick="sendAutomaticReminder(this, '<%= clientData.name %>', '<%= clientData.phone %>', '<%= a.formatted %>')" class="btn btn-success btn-sm">
                          <i class="fab fa-whatsapp"></i> <span class="hidden-mobile">Lembrar</span>
                        </button>
                      <% } %>
                      <form action="/appointment/<%= a.id %>/edit-datetime" method="POST" onsubmit='return editDateTime(this, "<%= datePart %>", "<%= timePart %>")' style="margin:0;">
                        <button class="btn btn-outline btn-sm"><i class="fas fa-edit"></i></button>
                      </form>
                      <form action="/appointment/<%= a.id %>/cancel" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este agendamento?')" style="margin:0;">
                        <button class="btn btn-outline btn-sm" style="color:var(--danger); border-color: var(--danger);"><i class="fas fa-trash"></i></button>
                      </form>
                    </div>
                  </div>

                  <% if (a.AppointmentServices && a.AppointmentServices.length) { %>
                    <div class="divider"></div>
                    <% a.AppointmentServices.forEach(function(service) {
                      var svcPaid = (service.AppointmentPayments || []).reduce(function(sum, p) { return sum + parseFloat(p.amount); }, 0);
                      var svcRemaining = parseFloat(service.price) - svcPaid;
                      var isSvcPaid = svcRemaining <= 0;
                    %>
                      <div style="padding: 8px 0; border-bottom: 1px solid var(--border-light);">
                        <div class="flex items-center justify-between" style="flex-wrap: wrap; gap: 8px;">
                          <div>
                            <span class="font-medium"><%= service.name %></span>
                            <% if (isSvcPaid) { %>
                              <span class="badge badge-success" style="margin-left:6px;">Pago</span>
                            <% } else { %>
                              <span class="badge badge-warning" style="margin-left:6px;">Pendente</span>
                            <% } %>
                            <div class="text-xs text-secondary mt-1">
                              R$ <%= parseFloat(service.price).toFixed(2) %>
                              <% if (svcPaid > 0) { %> | Pago: R$ <%= svcPaid.toFixed(2) %><% } %>
                              <% if (svcRemaining > 0) { %> | <span class="text-danger">Restante: R$ <%= svcRemaining.toFixed(2) %></span><% } %>
                            </div>
                          </div>
                          <div class="flex gap-1">
                            <form action="/appointment/<%= a.id %>/pay-service/<%= service.id %>" method="POST" onsubmit="return pagarValor(this)" data-remaining="<%= svcRemaining %>" style="margin:0;">
                              <button class="btn btn-success btn-sm"><i class="fas fa-credit-card"></i></button>
                            </form>
                            <form action="/appointment/<%= a.id %>/edit-service/<%= service.id %>" method="POST" onsubmit="return editItem(this, '<%= service.name %>', '<%= service.price %>')" style="margin:0;">
                              <button class="btn btn-outline btn-sm"><i class="fas fa-edit"></i></button>
                            </form>
                            <form action="/appointment/<%= a.id %>/remove-service/<%= service.id %>" method="POST" onsubmit="return confirm('Excluir?')" style="margin:0;">
                              <button class="btn btn-ghost btn-sm" style="color:var(--danger);"><i class="fas fa-trash"></i></button>
                            </form>
                          </div>
                        </div>

                        <% if (service.AppointmentPayments && service.AppointmentPayments.length) { %>
                          <div class="mt-2">
                            <% service.AppointmentPayments.forEach(function(payment) { %>
                              <div class="flex items-center justify-between text-xs" style="padding: 3px 0;">
                                <span><i class="fas fa-check-circle text-success"></i> <%= new Date(payment.paidAt).toLocaleDateString('pt-BR') %> - R$ <%= parseFloat(payment.amount).toFixed(2) %> (<%= payment.method %>)</span>
                                <form action="/appointment/<%= a.id %>/remove-payment/service/<%= service.id %>/<%= payment.id %>" method="POST" onsubmit="return confirm('Excluir?')" style="margin:0;">
                                  <button class="btn btn-ghost" style="color:var(--danger); padding:1px 4px; font-size:0.65rem;"><i class="fas fa-trash"></i></button>
                                </form>
                              </div>
                            <% }); %>
                          </div>
                        <% } %>
                      </div>
                    <% }); %>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sidebar direita -->
  <div class="col-span-4 flex flex-col gap-4">
    <% if (typeof isHistory === 'undefined' || !isHistory) { %>
    <!-- Resumo financeiro -->
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-chart-line" style="color: var(--success); margin-right: 8px;"></i> Resumo</h3></div>
      <div class="card-body">
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-secondary">Total Servicos</span>
            <span class="font-bold amount-positive">R$ <%= totalService.toFixed(2) %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-secondary">Pago (Serv.)</span>
            <span class="font-bold" style="color: var(--info);">R$ <%= totalPaidService.toFixed(2) %></span>
          </div>
          <div class="divider"></div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-secondary">Total Produtos</span>
            <span class="font-bold" style="color: var(--primary);">R$ <%= totalProduct.toFixed(2) %></span>
          </div>
          <div class="divider"></div>
          <div class="flex items-center justify-between">
            <span class="font-semibold text-danger">Restante Total</span>
            <span class="font-bold text-danger" style="font-size: 1.2rem;">
              R$ <%= (totalService + totalProduct - (totalPaidService + totalPaidProduct)).toFixed(2) %>
            </span>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Acoes rapidas -->
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-bolt" style="color: var(--warning); margin-right: 8px;"></i> Acoes</h3></div>
      <div class="card-body">
        <div class="flex flex-col gap-2">
          <% if (typeof isHistory === 'undefined' || !isHistory) { %>
            <button onclick="scrollToElement('form[action=\'/appointment\']')" class="btn btn-primary btn-block">
              <i class="fas fa-calendar-plus"></i> Novo Agendamento
            </button>
            <button onclick="scrollToElement('form[action*=\'/add-product\']')" class="btn btn-outline btn-block">
              <i class="fas fa-plus"></i> Adicionar Produto
            </button>
            <a href="/client/<%= clientData.id %>/historico" class="btn btn-outline btn-block">
              <i class="fas fa-history"></i> Historico Completo
            </a>
          <% } else { %>
            <a href="/client/<%= clientData.id %>" class="btn btn-primary btn-block">
              <i class="fas fa-arrow-left"></i> Voltar aos Detalhes
            </a>
          <% } %>
          <a href="/clients" class="btn btn-ghost btn-block"><i class="fas fa-users"></i> Todos os clientes</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de pagamento -->
<div id="payment-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:100; align-items:center; justify-content:center; padding:16px;">
  <div class="card" style="max-width: 420px; width: 100%;">
    <div class="card-header">
      <h3 id="payment-modal-title">Registrar Pagamento</h3>
      <button onclick="closeModal('payment-modal')" class="btn btn-ghost btn-sm"><i class="fas fa-times"></i></button>
    </div>
    <div class="card-body">
      <form id="payment-modal-form" method="POST">
        <div class="form-group">
          <label class="form-label">Valor Pago</label>
          <input type="number" step="0.01" name="amount" required class="form-control">
        </div>
        <div class="form-group">
          <label class="form-label">Forma de Pagamento</label>
          <select name="method" required class="form-control">
            <option value="Pix">Pix</option>
            <option value="Dinheiro">Dinheiro</option>
            <option value="Cartao">Cartao</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Data</label>
          <input type="date" name="paidAt" required class="form-control">
        </div>
        <div class="form-group">
          <label class="form-label">Descricao (opcional)</label>
          <input type="text" name="description" class="form-control">
        </div>
        <div class="flex gap-2 justify-end">
          <button type="button" onclick="closeModal('payment-modal')" class="btn btn-outline">Cancelar</button>
          <button type="submit" class="btn btn-success">Salvar Pagamento</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openModal(id) { var m = document.getElementById(id); if(m) m.style.display = 'flex'; }
  function closeModal(id) { var m = document.getElementById(id); if(m) m.style.display = 'none'; }
  function getTodayIso() { return new Date().toISOString().split('T')[0]; }
  function scrollToElement(sel) { var el = document.querySelector(sel); if(el) el.scrollIntoView({behavior:'smooth'}); }

  // Carregar servicos ao selecionar profissional
  (function() {
    var staffSelect = document.querySelector('select[name="staffId"]');
    var container = document.getElementById('serviceCheckboxes');
    var durationInput = document.querySelector('input[name="duration"]');
    if (!staffSelect || !container) return;

    staffSelect.addEventListener('change', async function() {
      container.innerHTML = '';
      if (durationInput) durationInput.value = '';
      if (!this.value) {
        container.innerHTML = '<span class="text-sm text-secondary">Selecione um profissional para ver os servicos</span>';
        return;
      }
      container.innerHTML = '<span class="text-sm text-secondary"><i class="fas fa-spinner spinner"></i> Carregando...</span>';
      try {
        var res = await fetch('/api/admin/services-by-staff/' + this.value);
        var services = await res.json();
        container.innerHTML = '';
        if (!services.length) {
          container.innerHTML = '<span class="text-sm text-secondary">Nenhum servico vinculado a este profissional</span>';
          return;
        }
        services.forEach(function(s) {
          var label = document.createElement('label');
          label.className = 'flex items-center gap-2 cursor-pointer';
          label.style.padding = '6px 8px';
          label.style.borderRadius = 'var(--radius)';
          label.style.background = 'var(--bg-body)';
          label.style.marginBottom = '4px';
          var cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.className = 'service-check';
          cb.dataset.name = s.name;
          cb.dataset.price = s.price;
          cb.dataset.duration = s.duration;
          cb.addEventListener('change', updateDuration);
          label.appendChild(cb);
          var text = document.createElement('span');
          text.style.flex = '1';
          text.innerHTML = '<strong>' + s.name + '</strong> <span class="text-secondary text-xs">R$ ' + parseFloat(s.price).toFixed(2) + ' | ' + s.duration + 'min</span>';
          label.appendChild(text);
          container.appendChild(label);
        });
      } catch(e) {
        container.innerHTML = '<span class="text-sm text-danger">Erro ao carregar servicos</span>';
      }
    });

    function updateDuration() {
      if (!durationInput) return;
      var total = 0;
      document.querySelectorAll('.service-check:checked').forEach(function(cb) {
        total += parseInt(cb.dataset.duration) || 0;
      });
      durationInput.value = total || '';
    }
  })();

  function processForm() {
    var services = [];
    document.querySelectorAll('.service-check:checked').forEach(function(cb) {
      services.push({ name: cb.dataset.name, price: parseFloat(cb.dataset.price) });
    });
    if (services.length === 0) {
      alert('Selecione pelo menos um servico.');
      return false;
    }
    var si = document.getElementById('servicesInput');
    var pi = document.getElementById('productsInput');
    if (si) si.value = JSON.stringify(services);
    if (pi) pi.value = JSON.stringify([]);
    return true;
  }

  function pagarValor(form) {
    var modal = document.getElementById('payment-modal');
    var modalForm = document.getElementById('payment-modal-form');
    var remaining = parseFloat(form.dataset.remaining);
    modalForm.action = form.action;
    var title = 'Item';
    var titleEl = form.closest('.card-body, .compact').querySelector('.font-semibold, .font-medium');
    if (titleEl) title = titleEl.innerText;
    modal.querySelector('#payment-modal-title').innerText = 'Pagar: ' + title;
    var amountInput = modalForm.querySelector('input[name="amount"]');
    amountInput.value = (!isNaN(remaining) && remaining > 0) ? remaining.toFixed(2) : '';
    modalForm.querySelector('input[name="paidAt"]').value = getTodayIso();
    modalForm.querySelector('input[name="description"]').value = '';
    openModal('payment-modal');
    return false;
  }

  function editItem(form, oldName, oldPrice) {
    var nome = prompt('Novo nome:', oldName);
    if (nome === null) return false;
    var preco = prompt('Novo preco:', oldPrice);
    if (preco === null) return false;
    var i1 = document.createElement('input'); i1.type='hidden'; i1.name='name'; i1.value=nome; form.appendChild(i1);
    var i2 = document.createElement('input'); i2.type='hidden'; i2.name='price'; i2.value=preco; form.appendChild(i2);
    return true;
  }

  function editClient(form, oldName, oldPhone) {
    var nome = prompt('Novo nome:', oldName);
    if (nome === null) return false;
    var tel = prompt('Novo telefone:', oldPhone);
    if (tel === null) return false;
    var i1 = document.createElement('input'); i1.type='hidden'; i1.name='name'; i1.value=nome; form.appendChild(i1);
    var i2 = document.createElement('input'); i2.type='hidden'; i2.name='phone'; i2.value=tel; form.appendChild(i2);
    return true;
  }

  function editDateTime(form, oldDate, oldTime) {
    var parts = oldDate.split('/');
    var userDate = prompt('Nova data (DD/MM/YYYY):', oldDate);
    if (userDate === null) return false;
    var m = userDate.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!m) { alert('Data invalida. Use DD/MM/YYYY.'); return false; }
    var isoDate = m[3] + '-' + m[2] + '-' + m[1];
    var userTime = prompt('Novo horario (HH:MM):', oldTime);
    if (userTime === null) return false;
    if (!/^\d{2}:\d{2}$/.test(userTime)) { alert('Horario invalido.'); return false; }
    var i1 = document.createElement('input'); i1.type='hidden'; i1.name='date'; i1.value=isoDate; form.appendChild(i1);
    var i2 = document.createElement('input'); i2.type='hidden'; i2.name='time'; i2.value=userTime; form.appendChild(i2);
    return true;
  }

  async function sendAutomaticReminder(button, clientName, clientPhone, apptDateTime) {
    var orig = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner spinner"></i> Enviando...';
    var orgName = "<%= typeof organization !== 'undefined' ? organization.name : 'AgendaPro' %>";
    var msg = 'Ola, ' + clientName + '!\n\nLembramos do seu horario no *' + orgName + '*: ' + apptDateTime + '.\nEstamos te esperando!';
    try {
      var res = await fetch('/api/send-reminder', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({phone: clientPhone, message: msg})
      });
      var data = await res.json();
      if (res.ok) {
        button.className = 'btn btn-success btn-sm';
        button.innerHTML = '<i class="fas fa-check"></i> Enviado';
      } else {
        alert('Erro: ' + (data.error || 'Falha'));
        button.disabled = false; button.innerHTML = orig;
      }
    } catch(e) {
      alert('Erro de conexao.');
      button.disabled = false; button.innerHTML = orig;
    }
  }
</script>

