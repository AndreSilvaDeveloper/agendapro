<%- include('partials/head', { pageTitle: 'Despesas' }) %>
<%- include('partials/sidebar', { activePage: 'despesas' }) %>

<div class="grid" style="grid-template-columns: 380px 1fr; gap: 24px;">

  <!-- Nova despesa -->
  <div class="flex flex-col gap-4">
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-plus-circle" style="color: var(--danger); margin-right: 8px;"></i> Nova Despesa</h3>
      </div>
      <div class="card-body">
        <form action="/expenses" method="POST" id="expenseForm">
          <div class="form-group">
            <label class="form-label">Data</label>
            <input type="date" name="date" id="expenseDate" required class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Categoria</label>
            <select name="category" required class="form-control">
              <option value="">Selecione...</option>
              <option value="luz">Luz</option>
              <option value="agua">Agua</option>
              <option value="aluguel">Aluguel</option>
              <option value="produtos">Produtos</option>
              <option value="comissao calcinhas">Comissao Calcinhas</option>
              <option value="comissao joias">Comissao Joias</option>
              <option value="outros gastos">Outros Gastos</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Descricao (opcional)</label>
            <input type="text" name="description" placeholder="Detalhes..." class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Valor (R$)</label>
            <input type="text" name="amount" required placeholder="0,00" class="form-control">
          </div>
          <button type="submit" class="btn btn-danger btn-block">
            <i class="fas fa-save"></i> Registrar Despesa
          </button>
        </form>
      </div>
    </div>

    <!-- Total -->
    <div class="stat-card">
      <div class="flex items-center justify-between">
        <div>
          <div class="stat-label">Total em despesas</div>
          <div class="stat-value amount-negative">
            R$ <%
              var totalExp = 0;
              if (typeof expenses !== 'undefined' && expenses) {
                expenses.forEach(function(e) { totalExp += parseFloat(e.amount || 0); });
              }
            %><%= totalExp.toFixed(2).replace('.', ',') %>
          </div>
        </div>
        <div class="stat-icon red"><i class="fas fa-arrow-down"></i></div>
      </div>
    </div>
  </div>

  <!-- Lista -->
  <div class="card">
    <div class="card-header">
      <h3>Despesas Registradas</h3>
      <span class="badge badge-neutral"><%= typeof expenses !== 'undefined' ? expenses.length : 0 %></span>
    </div>

    <% if (!expenses || expenses.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-receipt"></i>
        <p>Nenhuma despesa registrada.</p>
      </div>
    <% } else { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Data</th>
              <th>Categoria</th>
              <th>Descricao</th>
              <th class="text-right">Valor</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% expenses.forEach(function(e) { %>
              <tr>
                <td class="text-sm"><%= new Date(e.date).toLocaleDateString('pt-BR') %></td>
                <td><span class="badge badge-neutral"><%= e.category %></span></td>
                <td class="text-sm text-secondary"><%= e.description || '-' %></td>
                <td class="text-right amount-negative">R$ <%= parseFloat(e.amount).toFixed(2).replace('.', ',') %></td>
                <td class="text-right">
                  <form action="/expenses/<%= e.id %>/delete" method="POST" onsubmit="return confirm('Excluir esta despesa?')" style="margin:0;">
                    <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--danger);"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  // Set today as default date
  var dateInput = document.getElementById('expenseDate');
  if (dateInput && !dateInput.value) dateInput.valueAsDate = new Date();
</script>

<%- include('partials/footer') %>
