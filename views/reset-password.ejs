<%- include('partials/head', { pageTitle: 'Redefinir Senha' }) %>
<body class="auth-page">
  <div style="width: 100%; max-width: 420px;">
    <div class="auth-card animate-fade-in">
      <div class="auth-header">
        <i class="fas fa-lock-open" style="font-size: 2rem; margin-bottom: 12px;"></i>
        <h1>Nova Senha</h1>
        <p>Escolha uma nova senha segura</p>
      </div>

      <div class="auth-body">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <form action="/reset/<%= token %>" method="POST">
          <div class="form-group">
            <label class="form-label">Nova senha</label>
            <input type="password" name="password" required placeholder="Minimo 6 caracteres" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Confirmar senha</label>
            <input type="password" name="confirmPassword" required placeholder="Repita a senha" class="form-control">
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">
            <i class="fas fa-save"></i> Redefinir senha
          </button>
        </form>
      </div>

      <div class="auth-footer">
        <a href="/login">Voltar ao login</a>
      </div>
    </div>
  </div>
</body>
</html>
