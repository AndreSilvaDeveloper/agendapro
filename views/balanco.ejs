<%- include('partials/head', { pageTitle: 'Balanco Geral' }) %>
<%- include('partials/sidebar', { activePage: 'balanco' }) %>

<!-- KPIs -->
<div class="grid grid-3 mb-6">
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Total Receita</div>
        <div class="stat-value amount-positive">R$ <%= (totalReceita || 0).toFixed(2).replace('.', ',') %></div>
      </div>
      <div class="stat-icon green"><i class="fas fa-arrow-up"></i></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Total Despesas</div>
        <div class="stat-value amount-negative">R$ <%= (totalDespesa || 0).toFixed(2).replace('.', ',') %></div>
      </div>
      <div class="stat-icon red"><i class="fas fa-arrow-down"></i></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Saldo Liquido</div>
        <% var liq = (typeof liquido !== 'undefined') ? liquido : 0; %>
        <div class="stat-value" style="color: <%= liq >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
          R$ <%= liq.toFixed(2).replace('.', ',') %>
        </div>
      </div>
      <div class="stat-icon <%= liq >= 0 ? 'green' : 'red' %>"><i class="fas fa-balance-scale"></i></div>
    </div>
  </div>
</div>

<!-- Charts -->
<div class="grid grid-2 mb-6">
  <div class="card">
    <div class="card-header"><h3>Receitas vs Despesas</h3></div>
    <div class="card-body" style="display:flex; justify-content:center;">
      <canvas id="chartBalance" width="300" height="300"></canvas>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3>Servicos vs Produtos</h3></div>
    <div class="card-body" style="display:flex; justify-content:center;">
      <canvas id="chartSvcProd" width="300" height="300"></canvas>
    </div>
  </div>
</div>

<!-- Tabela mensal -->
<% if (typeof monthlyTotals !== 'undefined' && monthlyTotals && monthlyTotals.length > 0) { %>
<div class="card mb-6">
  <div class="card-header"><h3>Faturamento Mensal</h3></div>
  <div class="table-container">
    <table>
      <thead>
        <tr><th>Mes</th><th class="text-right">Receita</th><th class="text-right">Despesa</th><th class="text-right">Saldo</th></tr>
      </thead>
      <tbody>
        <% monthlyTotals.forEach(function(m) { %>
          <% var saldo = (m.receita || 0) - (m.despesa || 0); %>
          <tr>
            <td class="font-medium"><%= m.month %></td>
            <td class="text-right amount-positive">R$ <%= (m.receita || 0).toFixed(2).replace('.', ',') %></td>
            <td class="text-right amount-negative">R$ <%= (m.despesa || 0).toFixed(2).replace('.', ',') %></td>
            <td class="text-right font-bold" style="color: <%= saldo >= 0 ? 'var(--success)' : 'var(--danger)' %>">
              R$ <%= saldo.toFixed(2).replace('.', ',') %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Analise rapida -->
<div class="card">
  <div class="card-header"><h3><i class="fas fa-lightbulb" style="color: var(--warning); margin-right: 8px;"></i> Analise</h3></div>
  <div class="card-body">
    <% if (liq > 0) { %>
      <div class="alert alert-success"><i class="fas fa-thumbs-up"></i> O negocio esta com saldo positivo! Lucro de R$ <%= liq.toFixed(2).replace('.', ',') %>.</div>
    <% } else if (liq === 0) { %>
      <div class="alert alert-warning"><i class="fas fa-equals"></i> Receitas e despesas estao empatadas.</div>
    <% } else { %>
      <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> Atencao: despesas superam receitas em R$ <%= Math.abs(liq).toFixed(2).replace('.', ',') %>.</div>
    <% } %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Balance chart
  new Chart(document.getElementById('chartBalance'), {
    type: 'doughnut',
    data: {
      labels: ['Receita', 'Despesa'],
      datasets: [{
        data: [<%= totalReceita || 0 %>, <%= totalDespesa || 0 %>],
        backgroundColor: ['#10B981', '#EF4444'],
        borderWidth: 0
      }]
    },
    options: { responsive: false, plugins: { legend: { position: 'bottom' } } }
  });

  // Services vs Products
  new Chart(document.getElementById('chartSvcProd'), {
    type: 'pie',
    data: {
      labels: ['Servicos', 'Produtos'],
      datasets: [{
        data: [<%= typeof serviceCount !== 'undefined' ? serviceCount : 0 %>, <%= typeof productCount !== 'undefined' ? productCount : 0 %>],
        backgroundColor: ['#4F46E5', '#F59E0B'],
        borderWidth: 0
      }]
    },
    options: { responsive: false, plugins: { legend: { position: 'bottom' } } }
  });
</script>

<%- include('partials/footer') %>
