<%- include('../partials/head', { pageTitle: (org && org.name ? org.name : 'Salao') + ' - Agendamento Online' }) %>
<body style="background: var(--bg-body); color: var(--text-primary);">

  <!-- Hero -->
  <div style="background: var(--primary); color: #fff; padding: 48px 20px; text-align: center; position:relative;">
    <% if (org && org.coverImageUrl) { %>
      <div style="position:absolute; inset:0; background: url('<%= org.coverImageUrl %>') center/cover; opacity:0.3;"></div>
    <% } %>
    <div style="position:relative; z-index:1; max-width:600px; margin:0 auto;">
      <h1 style="font-size: 2.5rem; color: #fff; margin-bottom: 8px;"><%= org ? org.name : 'Salao' %></h1>
      <% if (org && org.address) { %>
        <p style="opacity:0.85;"><i class="fas fa-map-marker-alt" style="margin-right:6px;"></i><%= org.address %></p>
      <% } %>
      <div style="margin-top: 24px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a href="/portal/<%= typeof orgIdSafe !== 'undefined' ? orgIdSafe : (org ? org.id : '') %>/login" class="btn btn-lg" style="background:#fff; color: var(--primary);"><i class="fas fa-sign-in-alt"></i> Entrar</a>
        <a href="/portal/<%= typeof orgIdSafe !== 'undefined' ? orgIdSafe : (org ? org.id : '') %>/registro" class="btn btn-outline btn-lg" style="border-color:#fff; color:#fff;"><i class="fas fa-user-plus"></i> Criar conta</a>
      </div>
    </div>
  </div>

  <main style="max-width: 900px; margin: 0 auto; padding: 32px 16px;">

    <!-- Informacoes -->
    <% if (org) { %>
      <div class="grid grid-3 mb-6">
        <% if (org.whatsapp || org.phone) { %>
          <div class="card">
            <div class="card-body text-center">
              <i class="fab fa-whatsapp" style="font-size:1.5rem; color:#25D366; margin-bottom:8px;"></i>
              <div class="font-semibold">Contato</div>
              <div class="text-sm text-secondary"><%= org.whatsapp || org.phone %></div>
            </div>
          </div>
        <% } %>

        <% var settings = org.settings || {}; %>
        <% if (settings.showOperatingHours && org.operatingHours) { %>
          <div class="card">
            <div class="card-body text-center">
              <i class="fas fa-clock" style="font-size:1.5rem; color:var(--primary); margin-bottom:8px;"></i>
              <div class="font-semibold">Horarios</div>
              <div class="text-xs text-secondary"><%= typeof org.operatingHours === 'string' ? org.operatingHours : JSON.stringify(org.operatingHours) %></div>
            </div>
          </div>
        <% } %>

        <% if (settings.showAddress && org.address) { %>
          <div class="card">
            <div class="card-body text-center">
              <i class="fas fa-map-marker-alt" style="font-size:1.5rem; color:var(--danger); margin-bottom:8px;"></i>
              <div class="font-semibold">Endereco</div>
              <div class="text-xs text-secondary"><%= org.address %></div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Servicos -->
    <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
      <h2 class="mb-4"><i class="fas fa-cut" style="color:var(--primary); margin-right:8px;"></i> Servicos</h2>
      <div class="grid grid-3 mb-6">
        <% services.forEach(function(s) { %>
          <div class="card">
            <div class="card-body">
              <div class="font-semibold mb-1"><%= s.name %></div>
              <% if (s.description) { %><div class="text-xs text-secondary mb-2"><%= s.description %></div><% } %>
              <div class="flex items-center justify-between">
                <span class="font-bold" style="color: var(--success);">R$ <%= parseFloat(s.price).toFixed(2).replace('.', ',') %></span>
                <span class="text-xs text-secondary"><%= s.duration %> min</span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- Equipe -->
    <% if (typeof staff !== 'undefined' && staff && staff.length > 0) { %>
      <h2 class="mb-4"><i class="fas fa-users" style="color:var(--primary); margin-right:8px;"></i> Equipe</h2>
      <div class="grid grid-4 mb-6">
        <% staff.forEach(function(s) { %>
          <div class="card text-center">
            <div class="card-body">
              <% if (s.imageUrl) { %>
                <img src="<%= s.imageUrl %>" style="width:64px; height:64px; border-radius:50%; object-fit:cover; margin:0 auto 8px;">
              <% } else { %>
                <div class="list-item-avatar avatar-primary" style="width:64px; height:64px; font-size:1.5rem; margin:0 auto 8px;"><i class="fas fa-user"></i></div>
              <% } %>
              <div class="font-semibold"><%= s.name %></div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- CTA -->
    <div class="text-center" style="padding: 40px 0;">
      <a href="/portal/<%= typeof orgIdSafe !== 'undefined' ? orgIdSafe : (org ? org.id : '') %>/registro" class="btn btn-primary btn-lg">
        <i class="fas fa-calendar-plus"></i> Agendar Agora
      </a>
    </div>
  </main>

  <footer style="text-align:center; padding:20px; border-top:1px solid var(--border-color);">
    <span class="text-xs text-secondary">Powered by AgendaPro</span>
  </footer>
</body>
</html>
