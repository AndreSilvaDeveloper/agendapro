<%- include('../partials/head', { pageTitle: 'Nao encontrado' }) %>
<body class="auth-page">
  <div class="text-center" style="max-width: 400px;">
    <i class="fas fa-exclamation-triangle" style="font-size: 4rem; color: var(--warning); margin-bottom: 20px;"></i>
    <h1 style="margin-bottom: 8px;">Salao nao encontrado</h1>
    <% if (typeof slug !== 'undefined') { %>
      <p class="text-secondary mb-4">O endereco "<strong><%= slug %></strong>" nao existe ou foi removido.</p>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <p class="text-secondary mb-4"><%= error %></p>
    <% } %>
    <a href="/login" class="btn btn-primary"><i class="fas fa-home"></i> Ir para o login</a>
  </div>
</body>
</html>
