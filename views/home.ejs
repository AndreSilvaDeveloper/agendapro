<%- include('partials/head', { pageTitle: 'Clientes' }) %>
<%- include('partials/sidebar', { activePage: 'clientes' }) %>

<div class="grid" style="grid-template-columns: 340px 1fr; gap: 24px;">

  <!-- Painel lateral -->
  <div class="flex flex-col gap-4">
    <!-- Novo cliente -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-user-plus" style="color: var(--primary); margin-right: 8px;"></i> Novo Cliente</h3>
      </div>
      <div class="card-body">
        <form action="/client" method="POST">
          <div class="form-group">
            <label class="form-label">Nome Completo</label>
            <input type="text" name="name" placeholder="Nome do cliente" required class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Telefone</label>
            <input type="text" name="phone" id="phoneInput" placeholder="(11) 99999-9999" required class="form-control">
          </div>
          <button type="submit" class="btn btn-primary btn-block">
            <i class="fas fa-plus"></i> Cadastrar
          </button>
        </form>
      </div>
    </div>

    <!-- Buscar -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-search" style="color: var(--primary); margin-right: 8px;"></i> Buscar</h3>
      </div>
      <div class="card-body">
        <form action="/search" method="GET">
          <div class="form-group">
            <input type="text" name="q" placeholder="Nome ou telefone..." required
                   value="<%= typeof query !== 'undefined' ? query : '' %>" class="form-control">
          </div>
          <button type="submit" class="btn btn-outline btn-block">
            <i class="fas fa-search"></i> Pesquisar
          </button>
        </form>
      </div>
    </div>

    <!-- Total -->
    <div class="stat-card">
      <div class="flex items-center justify-between">
        <div>
          <div class="stat-label">Total de clientes</div>
          <div class="stat-value"><%= (typeof clients !== 'undefined') ? clients.length : 0 %></div>
        </div>
        <div class="stat-icon purple"><i class="fas fa-users"></i></div>
      </div>
    </div>
  </div>

  <!-- Lista -->
  <div class="card" style="min-height: 400px;">
    <div class="card-header">
      <h3>
        <% if (typeof query !== 'undefined' && query) { %>
          Resultados para "<%= query %>"
        <% } else { %>
          Lista de Clientes
        <% } %>
      </h3>
      <% if (typeof query !== 'undefined' && query) { %>
        <a href="/clients" class="btn btn-ghost btn-sm text-danger"><i class="fas fa-times"></i> Limpar</a>
      <% } %>
    </div>

    <div style="overflow-y: auto; max-height: calc(100vh - 180px);" class="custom-scroll">
      <% if (!clients || clients.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-users"></i>
          <p>Nenhum cliente encontrado.</p>
        </div>
      <% } else { %>
        <% clients.forEach(function(client) { %>
          <div class="list-item">
            <div class="list-item-avatar avatar-primary">
              <i class="fas fa-user"></i>
            </div>
            <div class="flex-1" style="min-width: 0;">
              <a href="/client/<%= client.id %>" class="font-semibold truncate block" style="text-decoration:none; color: var(--text-primary);">
                <%= client.name %>
              </a>
              <div class="text-xs text-secondary truncate">
                <i class="fas fa-phone" style="margin-right: 4px; font-size: 10px;"></i>
                <%= client.phone %>
              </div>
            </div>
            <div class="flex gap-1">
              <a href="/client/<%= client.id %>" class="btn btn-ghost btn-sm" title="Ver detalhes">
                <i class="fas fa-eye"></i>
              </a>
              <form action="/client/<%= client.id %>/delete" method="POST" onsubmit="return confirm('Excluir <%= client.name %>?')" style="margin:0;">
                <button type="submit" class="btn btn-ghost btn-sm" title="Excluir" style="color: var(--danger);">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<script>
  // Mascara de telefone
  var phoneInput = document.getElementById('phoneInput');
  if (phoneInput) {
    phoneInput.addEventListener('input', function(e) {
      var v = e.target.value.replace(/\D/g, '');
      if (v.length >= 11) v = v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
      else if (v.length >= 7) v = v.replace(/(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3');
      else if (v.length >= 3) v = v.replace(/(\d{2})(\d{0,5})/, '($1) $2');
      e.target.value = v;
    });
  }
</script>

<%- include('partials/footer') %>
