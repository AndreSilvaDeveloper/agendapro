<%- include('partials/head', { pageTitle: 'Financeiro' }) %>
<%- include('partials/sidebar', { activePage: 'financeiro' }) %>

<!-- Filtro -->
<div class="card mb-4">
  <div class="card-body compact">
    <form method="GET" action="/financeiro" class="flex items-center gap-3" style="flex-wrap: wrap;">
      <label class="form-label" style="margin:0;">Filtrar por:</label>
      <input type="date" name="day" value="<%= typeof dayValue !== 'undefined' ? dayValue : '' %>" class="form-control" style="max-width: 170px;">
      <input type="week" name="week" value="<%= typeof weekValue !== 'undefined' ? weekValue : '' %>" class="form-control" style="max-width: 170px;">
      <input type="month" name="month" value="<%= typeof monthValue !== 'undefined' ? monthValue : '' %>" class="form-control" style="max-width: 170px;">
      <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter"></i> Aplicar</button>
    </form>
  </div>
</div>

<% if (typeof label !== 'undefined' && label) { %>
  <div class="mb-4 text-sm text-secondary"><i class="fas fa-calendar"></i> <%= label %></div>
<% } %>

<!-- Stats -->
<div class="grid grid-3 mb-6">
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Total recebido</div>
        <div class="stat-value text-success">R$ <%= (overallTotal || 0).toFixed(2).replace('.', ',') %></div>
      </div>
      <div class="stat-icon green"><i class="fas fa-dollar-sign"></i></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Servicos</div>
        <div class="stat-value" style="color: var(--info);">R$ <%= (totalServicos || 0).toFixed(2).replace('.', ',') %></div>
      </div>
      <div class="stat-icon blue"><i class="fas fa-cut"></i></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Produtos</div>
        <div class="stat-value" style="color: var(--primary);">R$ <%= (totalProdutos || 0).toFixed(2).replace('.', ',') %></div>
      </div>
      <div class="stat-icon purple"><i class="fas fa-box"></i></div>
    </div>
  </div>
</div>

<!-- Por metodo -->
<div class="grid grid-3 mb-6">
  <% var methods = [{key:'pix', icon:'fa-qrcode', label:'Pix', color:'green'}, {key:'dinheiro', icon:'fa-money-bill', label:'Dinheiro', color:'yellow'}, {key:'cartao', icon:'fa-credit-card', label:'Cartao', color:'blue'}]; %>
  <% methods.forEach(function(m) { %>
    <div class="stat-card">
      <div class="flex items-center justify-between">
        <div>
          <div class="stat-label"><%= m.label %></div>
          <div class="stat-value">R$ <%= (typeof totals !== 'undefined' && totals[m.key] ? totals[m.key] : 0).toFixed(2).replace('.', ',') %></div>
        </div>
        <div class="stat-icon <%= m.color %>"><i class="fas <%= m.icon %>"></i></div>
      </div>
    </div>
  <% }); %>
</div>

<!-- Detalhes -->
<% if (typeof details !== 'undefined' && details) { %>
  <% ['pix','dinheiro','cartao'].forEach(function(method) { %>
    <% if (details[method] && details[method].length > 0) { %>
      <div class="card mb-4">
        <div class="card-header">
          <h3><i class="fas fa-list" style="margin-right: 8px; color: var(--primary);"></i> <%= method.charAt(0).toUpperCase() + method.slice(1) %></h3>
          <span class="badge badge-neutral"><%= details[method].length %></span>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Cliente</th>
                <th>Data</th>
                <th>Item</th>
                <th>Descricao</th>
                <th class="text-right">Valor</th>
              </tr>
            </thead>
            <tbody>
              <% details[method].forEach(function(d) { %>
                <tr>
                  <td class="font-medium"><%= d.clientName || '-' %></td>
                  <td class="text-sm text-secondary"><%= d.date || '-' %></td>
                  <td><%= d.itemName || '-' %></td>
                  <td class="text-sm text-secondary"><%= d.description || '-' %></td>
                  <td class="text-right amount-positive">R$ <%= parseFloat(d.amount || 0).toFixed(2).replace('.', ',') %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  <% }); %>
<% } %>

<%- include('partials/footer') %>
