<%- include('partials/head', { pageTitle: 'Dashboard' }) %>
<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

<!-- Stats -->
<div class="grid grid-4 mb-6">
  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Receita hoje</div>
        <div class="stat-value text-success">R$ <%= (receitaHoje || 0).toFixed(2).replace('.', ',') %></div>
      </div>
      <div class="stat-icon green"><i class="fas fa-dollar-sign"></i></div>
    </div>
  </div>

  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Receita do mes</div>
        <div class="stat-value" style="color: var(--info);">R$ <%= (receitaMes || 0).toFixed(2).replace('.', ',') %></div>
      </div>
      <div class="stat-icon blue"><i class="fas fa-chart-bar"></i></div>
    </div>
  </div>

  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Hoje</div>
        <div class="stat-value"><%= proximosHoje ? proximosHoje.length : 0 %></div>
      </div>
      <div class="stat-icon purple"><i class="fas fa-calendar-day"></i></div>
    </div>
    <div class="text-xs text-secondary mt-2">agendamentos</div>
  </div>

  <div class="stat-card">
    <div class="flex items-center justify-between">
      <div>
        <div class="stat-label">Amanha</div>
        <div class="stat-value"><%= proximosAmanha ? proximosAmanha.length : 0 %></div>
      </div>
      <div class="stat-icon yellow"><i class="fas fa-calendar"></i></div>
    </div>
    <div class="text-xs text-secondary mt-2">agendamentos</div>
  </div>
</div>

<!-- Link de agendamento -->
<% if (typeof org !== 'undefined' && org && org.slug) { %>
<div class="card mb-6">
  <div class="card-body compact flex items-center justify-between gap-3" style="flex-wrap: wrap;">
    <div class="flex items-center gap-2 text-sm">
      <i class="fas fa-link text-primary-color"></i>
      <span class="font-medium">Link de agendamento:</span>
      <input type="text" readonly id="publicLinkInput" data-path="/salao/<%= org.slug %>"
             value="Carregando..." class="form-control" style="max-width: 320px; padding: 5px 10px; font-size: 0.8rem;">
    </div>
    <div class="flex gap-2">
      <button onclick="copyLink()" class="btn btn-outline btn-sm"><i class="fas fa-copy"></i> Copiar</button>
      <button onclick="openDynamicLink()" class="btn btn-primary btn-sm"><i class="fas fa-external-link-alt"></i> Abrir</button>
    </div>
  </div>
</div>
<% } %>

<!-- Hoje + Amanha -->
<div class="grid" style="grid-template-columns: 1fr 1fr;">
  <!-- Hoje -->
  <div class="card">
    <div class="card-header">
      <h3><i class="fas fa-calendar-day" style="color: var(--primary); margin-right: 8px;"></i> Hoje</h3>
      <span class="badge badge-info"><%= proximosHoje ? proximosHoje.length : 0 %></span>
    </div>
    <div class="card-body custom-scroll" style="max-height: 500px; overflow-y: auto; padding: 8px;">
      <% if (!proximosHoje || proximosHoje.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-check-circle"></i>
          <p>Agenda livre hoje!</p>
        </div>
      <% } else { %>
        <div class="flex flex-col gap-2">
          <% proximosHoje.forEach(function(item) { %>
            <a href="/client/<%= item.clientId %>" class="appt-card" style="text-decoration: none; color: inherit;">
              <div class="appt-time"><%= item.time %></div>
              <div class="flex-1 min-h-0">
                <div class="font-semibold truncate"><%= item.name %></div>
                <div class="text-xs text-secondary truncate"><i class="fas fa-cut" style="margin-right: 4px;"></i><%= item.service %></div>
              </div>
              <i class="fas fa-chevron-right text-muted"></i>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Amanha -->
  <div class="card">
    <div class="card-header">
      <h3><i class="fas fa-sun" style="color: var(--warning); margin-right: 8px;"></i> Amanha</h3>
      <span class="badge badge-neutral"><%= proximosAmanha ? proximosAmanha.length : 0 %></span>
    </div>
    <div class="card-body custom-scroll" style="max-height: 500px; overflow-y: auto; padding: 8px;">
      <% if (!proximosAmanha || proximosAmanha.length === 0) { %>
        <div class="empty-state">
          <p>Nada agendado.</p>
        </div>
      <% } else { %>
        <div class="flex flex-col gap-2">
          <% proximosAmanha.forEach(function(item) { %>
            <div class="appt-card" style="opacity: 0.8;">
              <div class="appt-time" style="color: var(--text-secondary);"><%= item.time %></div>
              <div class="flex-1 min-h-0">
                <div class="font-medium truncate text-sm"><%= item.name %></div>
                <div class="text-xs text-secondary truncate"><%= item.service %></div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Hidden data for pending alerts -->
<div id="dashboard-data" class="hidden" data-pending='<%- JSON.stringify(pendingAppointments || []) %>'></div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Link dinmico
  document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('publicLinkInput');
    if (input) {
      input.value = window.location.origin + input.getAttribute('data-path');
    }
  });

  function openDynamicLink() {
    var input = document.getElementById('publicLinkInput');
    if (input && input.value) window.open(input.value, '_blank') || (window.location.href = input.value);
  }

  function copyLink() {
    var input = document.getElementById('publicLinkInput');
    if (!input) return;
    input.select();
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(input.value);
    } else {
      document.execCommand('copy');
    }
    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Link copiado!', showConfirmButton: false, timer: 1500 });
  }

  // Pendentes
  document.addEventListener('DOMContentLoaded', function() {
    var dataEl = document.getElementById('dashboard-data');
    if (!dataEl) return;
    try {
      var pending = JSON.parse(dataEl.dataset.pending || '[]');
      if (pending.length === 0) return;

      var html = '<div style="text-align:left; max-height:300px; overflow-y:auto; display:flex; flex-direction:column; gap:10px; padding:4px;">';
      pending.forEach(function(appt) {
        var d = new Date(appt.date);
        var dateStr = d.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit'});
        var timeStr = appt.time || d.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
        var cName = appt.Client ? appt.Client.name : 'Cliente';
        var sName = (appt.AppointmentServices && appt.AppointmentServices[0]) ? appt.AppointmentServices[0].name : 'Servico';

        html += '<div style="padding:12px; border:1px solid var(--border-color); border-radius:8px; background:var(--bg-card);">';
        html += '<div style="display:flex; justify-content:space-between; margin-bottom:8px;">';
        html += '<div><strong>' + cName + '</strong><br><small style="color:var(--text-secondary)">' + sName + '</small></div>';
        html += '<span class="badge badge-warning">' + dateStr + ' - ' + timeStr + '</span>';
        html += '</div>';
        html += '<div style="display:flex; gap:8px;">';
        html += '<form action="/admin/appointment/' + appt.id + '/confirm" method="POST" style="flex:1;margin:0;">';
        html += '<button class="btn btn-success btn-sm btn-block"><i class="fas fa-check"></i> Aceitar</button></form>';
        html += '<form action="/admin/appointment/' + appt.id + '/cancel-by-admin" method="POST" style="flex:1;margin:0;" onsubmit="return promptCancelReason(this)">';
        html += '<button class="btn btn-danger btn-sm btn-block"><i class="fas fa-times"></i> Recusar</button></form>';
        html += '</div></div>';
      });
      html += '</div>';

      Swal.fire({
        title: pending.length + ' agendamento(s) pendente(s)',
        html: html,
        showConfirmButton: false,
        showCloseButton: true,
        width: '420px',
        background: 'var(--bg-card)',
        color: 'var(--text-primary)'
      });
    } catch(e) { console.error(e); }
  });

  function promptCancelReason(form) {
    var r = prompt('Motivo do cancelamento:');
    if (!r || r.trim() === '') return false;
    var i = document.createElement('input');
    i.type = 'hidden'; i.name = 'cancellationReason'; i.value = r;
    form.appendChild(i);
    return true;
  }
</script>

<%- include('partials/footer') %>
