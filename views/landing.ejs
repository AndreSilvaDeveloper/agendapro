  <section class="landing-section" id="planos">
    <div class="landing-container">
      <div style="text-align: center;" class="fade-up">
        <span class="section-label">Planos</span>
        <h2 class="section-title">Planos que cabem no seu bolso</h2>
        <p class="section-subtitle">Comece gratis e evolua conforme seu negocio cresce.</p>
      </div>

      <div class="pricing-toggle fade-up">
        <span class="toggle-label active" id="monthlyLabel">Mensal</span>
        <button class="toggle-switch" id="pricingToggle" aria-label="Alternar periodo"></button>
        <span class="toggle-label" id="yearlyLabel">Anual</span>
        <span class="savings-badge" style="opacity: 0;" id="savingsBadge">Economize 20%</span>
      </div>

      <div class="pricing-grid stagger-children">
        <% if (typeof plans !== 'undefined' && plans && plans.length > 0) { %>
          <% plans.forEach(function(plan) { %>
            <%
              var monthlyPrice = parseFloat(plan.price) || 0;
              var yearlyPrice = Math.round(monthlyPrice * 0.8 * 100) / 100;
              var isFree = monthlyPrice === 0;
              var slug = plan.slug || plan.name.toLowerCase().replace(/\s+/g, '-');
              var features = plan.features || [];
              if (typeof features === 'string') {
                try { features = JSON.parse(features); } catch(e) { features = []; }
              }
            %>
            <div class="pricing-card fade-up <%= plan.isFeatured ? 'featured' : '' %>">
              <% if (plan.isFeatured) { %>
                <div class="popular-badge">Mais Popular</div>
              <% } %>
              <h3><%= plan.name %></h3>
              <div class="price" data-monthly="<%= monthlyPrice.toFixed(2) %>" data-yearly="<%= yearlyPrice.toFixed(2) %>">
                <% if (isFree) { %>
                  Gratis
                <% } else { %>
                  <span class="currency">R$</span><span class="price-value"><%= monthlyPrice.toFixed(2).replace('.', ',') %></span>
                <% } %>
              </div>
              <div class="price-period"><%= isFree ? 'Para sempre' : '/mes' %></div>

              <% if (features.length > 0) { %>
                <ul class="pricing-features">
                  <% features.forEach(function(f) { %>
                    <li><i class="fas fa-check"></i> <span><%= f %></span></li>
                  <% }); %>
                </ul>
              <% } %>

              <a href="/register?plan=<%= slug %>" class="pricing-btn <%= plan.isFeatured ? 'primary' : '' %>">
                <%= isFree ? 'Comecar Gratis' : 'Assinar Agora' %>
              </a>
            </div>
          <% }); %>
        <% } else { %>
          <!-- Placeholder plans when no data -->
          <div class="pricing-card fade-up">
            <h3>Gratis</h3>
            <div class="price" data-monthly="0" data-yearly="0">Gratis</div>
            <div class="price-period">Para sempre</div>
            <ul class="pricing-features">
              <li><i class="fas fa-check"></i> <span>1 profissional</span></li>
              <li><i class="fas fa-check"></i> <span>Agendamento online</span></li>
              <li><i class="fas fa-check"></i> <span>Portal do cliente</span></li>
              <li><i class="fas fa-check"></i> <span>Ate 50 agendamentos/mes</span></li>
            </ul>
            <a href="/register?plan=gratis" class="pricing-btn">Comecar Gratis</a>
          </div>

          <div class="pricing-card featured fade-up">
            <div class="popular-badge">Mais Popular</div>
            <h3>Profissional</h3>
            <div class="price" data-monthly="79.90" data-yearly="63.92">
              <span class="currency">R$</span><span class="price-value">79,90</span>
            </div>
            <div class="price-period">/mes</div>
            <ul class="pricing-features">
              <li><i class="fas fa-check"></i> <span>Ate 5 profissionais</span></li>
              <li><i class="fas fa-check"></i> <span>Bot WhatsApp com IA</span></li>
              <li><i class="fas fa-check"></i> <span>Lembretes automaticos</span></li>
              <li><i class="fas fa-check"></i> <span>Gestao financeira</span></li>
              <li><i class="fas fa-check"></i> <span>Relatorios completos</span></li>
              <li><i class="fas fa-check"></i> <span>Agendamentos ilimitados</span></li>
            </ul>
            <a href="/register?plan=profissional" class="pricing-btn primary">Assinar Agora</a>
