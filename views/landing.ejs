            <h3>Empresarial</h3>
            <div class="price" data-monthly="149.90" data-yearly="119.92">
              <span class="currency">R$</span><span class="price-value">149,90</span>
            </div>
            <div class="price-period">/mes</div>
            <ul class="pricing-features">
              <li><i class="fas fa-check"></i> <span>Profissionais ilimitados</span></li>
              <li><i class="fas fa-check"></i> <span>Tudo do Profissional</span></li>
              <li><i class="fas fa-check"></i> <span>Multiplas unidades</span></li>
